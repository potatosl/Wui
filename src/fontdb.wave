// SPDX-License-Identifier: MPL-2.0
//
// Finds the fonts the host OS ships and hands them to the text engine. wui
// bundles no font: Windows, macOS and Linux each have a default UI font on
// disk, searched here by file name in the standard font folders.
//
// TrueType (glyf) and OpenType-CFF fonts are supported; anything else is
// skipped and the next candidate is tried.
//
// Linux walks the font folders (the usual place is a few levels down, e.g.
// /usr/share/fonts/truetype/dejavu/); macOS the same with its folders and
// dirent layout (not tested); Windows looks the names up directly in
// %WINDIR%\Fonts (not tested).

import("std::mem::alloc")::{mem_alloc, mem_free};
import("std::fs::file")::{fs_read_all, fs_file_size};
import("./font")::{FontEngine, font_add, font_set_size};

extern(c, "getenv") fun c_getenv(name: ptr<u8>) -> ptr<u8>;

const PRIMARY_COUNT: i32 = 8;
const NAME_COUNT: i32 = 17;           // PRIMARY_COUNT primary names, then the fallbacks
const MAX_DEPTH: i32 = 6;
const MAX_FOUND: i32 = 64;
const PATH_CAP: i64 = 1024;

// Lower-case file names in priority order. The main UI face is the first one
// found among the primary names; the first one found among the fallback names
// covers characters the main face lacks (Hangul, CJK).
fun font_name(rank: i32) -> str {
    if (rank == 0) { return "segoeui.ttf"; }              // Windows
    if (rank == 1) { return "helvetica.ttc"; }            // macOS
    if (rank == 2) { return "arial.ttf"; }                // Windows, macOS
    if (rank == 3) { return "dejavusans.ttf"; }           // Linux
    if (rank == 4) { return "notosans-regular.ttf"; }
    if (rank == 5) { return "liberationsans-regular.ttf"; }
    if (rank == 6) { return "ubuntu-r.ttf"; }
    if (rank == 7) { return "freesans.ttf"; }
    if (rank == 8) { return "malgun.ttf"; }               // Windows
    if (rank == 9) { return "applesdgothicneo.ttc"; }     // macOS
    if (rank == 10) { return "applegothic.ttf"; }
    if (rank == 11) { return "nanumgothic.ttf"; }         // Linux
    if (rank == 12) { return "notosanscjk-regular.ttc"; } // Noto Sans CJK (CFF outlines)
    if (rank == 13) { return "notosanscjkkr-regular.otf"; }
    if (rank == 14) { return "droidsansfallbackfull.ttf"; }
    if (rank == 15) { return "msyh.ttc"; }
    return "msgothic.ttc";
}

fun cstr_len(p: ptr<u8>) -> i64 {
    var n: i64 = 0;
    while (p[n] != 0) { n += 1; }
    return n;
}

// Appends the NUL-terminated string `src` to `dst` at `at` (keeps it NUL-terminated);
// returns the new length. Stops before overflowing `cap`.
fun cat(dst: ptr<u8>, cap: i64, at: i64, src: ptr<u8>) -> i64 {
    var n: i64 = at;
    var i: i64 = 0;
    while (src[i] != 0 && n + 1 < cap) { dst[n] = src[i]; n += 1; i += 1; }
    dst[n] = 0;
    return n;
}

fun lower(c: u8) -> u8 {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

// The rank of file name `name` (any case) in the name list, or -1.
fun name_rank(name: ptr<u8>) -> i32 {
    var r: i32 = 0;
    while (r < NAME_COUNT) {
        var want: ptr<u8> = font_name(r) as ptr<u8>;
        var i: i64 = 0;
        var same: bool = true;
        while (same && (want[i] != 0 || name[i] != 0)) {
            if (lower(name[i]) != want[i]) { same = false; } else { i += 1; }
        }
        if (same) { return r; }
        r += 1;
    }
    return -1;
}

// Candidate font files found so far: rank and NUL-terminated path.
struct Found {
    count: i32;
    rank: ptr<i32>;
    path: ptr<u8>;                     // MAX_FOUND paths of PATH_CAP bytes
}

fun found_add(fd: ptr<Found>, rank: i32, path: ptr<u8>) {
    if (fd.count >= MAX_FOUND) { return; }
    fd.rank[fd.count] = rank;
    cat(&fd.path[(fd.count as i64) * PATH_CAP], PATH_CAP, 0, path);
    fd.count += 1;
}

// strcmp: negative, zero or positive.
fun path_cmp(a: ptr<u8>, b: ptr<u8>) -> i32 {
    var i: i64 = 0;
    while (a[i] != 0 && a[i] == b[i]) { i += 1; }
    return (a[i] as i32) - (b[i] as i32);
}

// Sorts the candidates by (rank, path).
fun found_sort(fd: ptr<Found>) {
    var tmp: ptr<u8> = mem_alloc(PATH_CAP);
    var i: i32 = 1;
    while (i < fd.count) {
        var j: i32 = i;
        var going: bool = true;
        while (going && j > 0) {
            var a: ptr<u8> = &fd.path[((j - 1) as i64) * PATH_CAP];
            var b: ptr<u8> = &fd.path[(j as i64) * PATH_CAP];
            var after: bool = fd.rank[j - 1] > fd.rank[j] || (fd.rank[j - 1] == fd.rank[j] && path_cmp(a, b) > 0);
            if (after) {
                cat(tmp, PATH_CAP, 0, a);
                cat(a, PATH_CAP, 0, b);
                cat(b, PATH_CAP, 0, tmp);
                var r: i32 = fd.rank[j - 1];
                fd.rank[j - 1] = fd.rank[j];
                fd.rank[j] = r;
                j -= 1;
            } else { going = false; }
        }
        i += 1;
    }
    mem_free(tmp, PATH_CAP);
}

// Reads the file and hands it to the engine. The engine keeps pointing into
// the data, so it is kept for the life of the process.
fun register(e: ptr<FontEngine>, path: ptr<u8>) -> bool {
    var size: i64 = fs_file_size(path as str);
    if (size <= 0) { return false; }
    var data: ptr<u8> = mem_alloc(size);
    if (fs_read_all(path as str, data, size) != size) {
        mem_free(data, size);
        return false;
    }
    if (font_add(e, data, size, 0)) { return true; }
    mem_free(data, size);
    return false;
}

fun load_found(e: ptr<FontEngine>, fd: ptr<Found>) {
    found_sort(fd);
    var done_primary: bool = false;
    var done_fallback: bool = false;
    var i: i32 = 0;
    while (i < fd.count) {
        var fallback: bool = fd.rank[i] >= PRIMARY_COUNT;
        var done: bool = done_primary;
        if (fallback) { done = done_fallback; }
        if (!done && register(e, &fd.path[(i as i64) * PATH_CAP])) {
            if (fallback) { done_fallback = true; } else { done_primary = true; }
        }
        i += 1;
    }
}

// ---- Linux / macOS: walk the font folders ----------------------------------------

#[target(os="linux")]
const DIRENT_TYPE: i64 = 18;
#[target(os="linux")]
const DIRENT_NAME: i64 = 19;
#[target(os="macos")]
const DIRENT_TYPE: i64 = 20;
#[target(os="macos")]
const DIRENT_NAME: i64 = 21;

#[target(os="linux")]
extern(c, "opendir") fun c_opendir(path: ptr<u8>) -> ptr<u8>;
#[target(os="linux")]
extern(c, "readdir") fun c_readdir(d: ptr<u8>) -> ptr<u8>;
#[target(os="linux")]
extern(c, "closedir") fun c_closedir(d: ptr<u8>) -> i32;

#[target(os="linux")]
fun walk(dir: ptr<u8>, depth: i32, fd: ptr<Found>) {
    var d: ptr<u8> = c_opendir(dir);
    if (d == null) { return; }
    var ent: ptr<u8> = c_readdir(d);
    while (ent != null) {
        var name: ptr<u8> = &ent[DIRENT_NAME];
        var dot: bool = name[0] == 46 && (name[1] == 0 || (name[1] == 46 && name[2] == 0));
        if (!dot) {
            var path: ptr<u8> = mem_alloc(PATH_CAP);
            var n: i64 = cat(path, PATH_CAP, 0, dir);
            n = cat(path, PATH_CAP, n, "/" as ptr<u8>);
            cat(path, PATH_CAP, n, name);
            var kind: u8 = ent[DIRENT_TYPE];
            var is_dir: bool = kind == 4;
            if (kind == 0) {                       // DT_UNKNOWN: ask the file system
                var probe: ptr<u8> = c_opendir(path);
                if (probe != null) { c_closedir(probe); is_dir = true; }
            }
            if (is_dir) {
                if (depth < MAX_DEPTH) { walk(path, depth + 1, fd); }
            } else {
                var rank: i32 = name_rank(name);
                if (rank >= 0) { found_add(fd, rank, path); }
            }
            mem_free(path, PATH_CAP);
        }
        ent = c_readdir(d);
    }
    c_closedir(d);
}

#[target(os="linux")]
fun discover(fd: ptr<Found>) {
    walk("/usr/share/fonts" as ptr<u8>, 0, fd);
    walk("/usr/local/share/fonts" as ptr<u8>, 0, fd);
    var home: ptr<u8> = c_getenv("HOME" as ptr<u8>);
    if (home != null) {
        var path: ptr<u8> = mem_alloc(PATH_CAP);
        var n: i64 = cat(path, PATH_CAP, 0, home);
        cat(path, PATH_CAP, n, "/.local/share/fonts" as ptr<u8>);
        walk(path, 0, fd);
        n = cat(path, PATH_CAP, 0, home);
        cat(path, PATH_CAP, n, "/.fonts" as ptr<u8>);
        walk(path, 0, fd);
        mem_free(path, PATH_CAP);
    }
}

// ---- other targets: no discovery yet -----------------------------------------------

#[target(os="windows")]
fun discover(fd: ptr<Found>) {
    // Looks every name up directly in %WINDIR%\Fonts (the file system is case-insensitive).
    var win: ptr<u8> = c_getenv("WINDIR" as ptr<u8>);
    var path: ptr<u8> = mem_alloc(PATH_CAP);
    var r: i32 = 0;
    while (r < NAME_COUNT) {
        var n: i64 = 0;
        if (win != null) { n = cat(path, PATH_CAP, 0, win); } else { n = cat(path, PATH_CAP, 0, "C:\\Windows" as ptr<u8>); }
        n = cat(path, PATH_CAP, n, "\\Fonts\\" as ptr<u8>);
        cat(path, PATH_CAP, n, font_name(r) as ptr<u8>);
        if (fs_file_size(path as str) > 0) { found_add(fd, r, path); }
        r += 1;
    }
    mem_free(path, PATH_CAP);
}

#[target(os="macos")]
fun discover(fd: ptr<Found>) {
    // Same lookup by name in the standard folders (no folder walk yet).
    var dirs: array<str, 3> = ["/System/Library/Fonts/", "/System/Library/Fonts/Supplemental/", "/Library/Fonts/"];
    var path: ptr<u8> = mem_alloc(PATH_CAP);
    var k: i32 = 0;
    while (k < 3) {
        var r: i32 = 0;
        while (r < NAME_COUNT) {
            var n: i64 = cat(path, PATH_CAP, 0, dirs[k] as ptr<u8>);
            cat(path, PATH_CAP, n, font_name(r) as ptr<u8>);
            if (fs_file_size(path as str) > 0) { found_add(fd, r, path); }
            r += 1;
        }
        k += 1;
    }
    mem_free(path, PATH_CAP);
}

// Loads the system fonts into `e` and sets the UI text size to 16 px. Call it
// once per engine. With no font found, text falls back to hollow boxes.
pub fun font_load_system(e: ptr<FontEngine>) {
    font_set_size(e, 16);
    var fd: Found = Found { count: 0, rank: mem_alloc((MAX_FOUND * 4) as i64) as ptr<i32>,
                            path: mem_alloc((MAX_FOUND as i64) * PATH_CAP) };
    discover(&fd);
    load_found(e, &fd);
    mem_free(fd.rank as ptr<u8>, (MAX_FOUND * 4) as i64);
    mem_free(fd.path, (MAX_FOUND as i64) * PATH_CAP);
}
