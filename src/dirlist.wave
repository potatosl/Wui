// SPDX-License-Identifier: MPL-2.0
//
// A directory listing for file pickers: the names in a directory, folders first, each group
// sorted by name (ASCII case-insensitive). Wave's std cannot list a directory, so this reads it
// through libc on Linux / FreeBSD (dir/posix.wave) and through the winplat crate on Windows /
// macOS (dir/native.wave).
//
//   var l: DirList = dirlist_new();
//   if (dirlist_read(&l, "/home")) {
//       var i: i32 = 0;
//       while (i < dirlist_count(&l)) { println("{}", dirlist_name(&l, i)); i += 1; }
//   }
//   dirlist_free(&l);
//
// Paths are UTF-8 with '/' as the separator (Windows accepts it too).

import("std::mem::alloc")::{mem_alloc, mem_free, mem_realloc};
import("std::env::cwd")::{env_getcwd};

#[target(os="linux")]
import("./dir/posix")::{dir_open, dir_next, dir_close};
#[target(os="freebsd")]
import("./dir/posix")::{dir_open, dir_next, dir_close};
#[target(os="windows")]
import("./dir/native")::{dir_open, dir_next, dir_close};
#[target(os="macos")]
import("./dir/native")::{dir_open, dir_next, dir_close};

const NAME_MAX: i64 = 1024;

pub struct DirList {
    names: ptr<u8>;                   // NUL-terminated names, one after the other (unsorted)
    used: i64;
    cap: i64;
    offs: ptr<i32>;                   // item -> offset of its name in `names`, in sorted order
    dirs: ptr<u8>;                    // item -> 1 for a directory
    count: i32;
    cap_items: i32;
}

pub fun dirlist_new() -> DirList {
    return DirList { names: mem_alloc(1024), used: 0, cap: 1024, offs: mem_alloc(64 * 4) as ptr<i32>, dirs: mem_alloc(64),
                     count: 0, cap_items: 64 };
}

pub fun dirlist_free(l: ptr<DirList>) {
    mem_free(l.names, l.cap);
    mem_free(l.offs as ptr<u8>, (l.cap_items * 4) as i64);
    mem_free(l.dirs, l.cap_items as i64);
    l.names = null;
    l.offs = null;
    l.dirs = null;
    l.count = 0;
}

pub fun dirlist_count(l: ptr<DirList>) -> i32 { return l.count; }

// The name of item `i` (NUL-terminated; valid until the next dirlist_read), or "" for a bad index.
pub fun dirlist_name(l: ptr<DirList>, i: i32) -> str {
    if (i < 0 || i >= l.count) { return ""; }
    return &l.names[l.offs[i]] as str;
}

pub fun dirlist_is_dir(l: ptr<DirList>, i: i32) -> bool {
    if (i < 0 || i >= l.count) { return false; }
    return l.dirs[i] != 0;
}

fun lower(b: u8) -> u8 {
    if (b >= 65 && b <= 90) { return b + 32; }
    return b;
}

// Does item a sort before item b (b given by its offset and kind)? Folders first, then by name.
fun before(l: ptr<DirList>, a_off: i32, a_dir: u8, b_off: i32, b_dir: u8) -> bool {
    if (a_dir != b_dir) { return a_dir > b_dir; }
    var i: i64 = 0;
    while (true) {
        var x: u8 = lower(l.names[a_off + i]);
        var y: u8 = lower(l.names[b_off + i]);
        if (x != y) { return x < y; }
        if (x == 0) { return false; }
        i += 1;
    }
    return false;
}

fun grow_items(l: ptr<DirList>) {
    var cap: i32 = l.cap_items * 2;
    l.offs = mem_realloc(l.offs as ptr<u8>, (l.cap_items * 4) as i64, (cap * 4) as i64) as ptr<i32>;
    l.dirs = mem_realloc(l.dirs, l.cap_items as i64, cap as i64);
    l.cap_items = cap;
}

// Joins dir and name into buf ("dir/name"); false when it does not fit.
fun join_path(buf: ptr<u8>, cap: i64, dir: ptr<u8>, name: ptr<u8>) -> bool {
    var n: i64 = 0;
    while (dir[n] != 0) {
        if (n + 2 >= cap) { return false; }
        buf[n] = dir[n];
        n += 1;
    }
    if (n > 0 && buf[n - 1] != 47) { buf[n] = 47; n += 1; }
    var i: i64 = 0;
    while (name[i] != 0) {
        if (n + 2 >= cap) { return false; }
        buf[n] = name[i];
        n += 1;
        i += 1;
    }
    buf[n] = 0;
    return true;
}

// Replaces the list with the contents of the directory `path` ("." and ".." left out). False when
// the directory cannot be read (the list is then empty).
pub fun dirlist_read(l: ptr<DirList>, path: str) -> bool {
    l.used = 0;
    l.count = 0;
    var p: ptr<u8> = path as ptr<u8>;
    var d: ptr<u8> = dir_open(p);
    if (d == null) { return false; }
    var buf: ptr<u8> = mem_alloc(NAME_MAX);
    var full: ptr<u8> = mem_alloc(NAME_MAX * 2);
    var kind: array<i32, 1>;
    kind[0] = 0;
    var raw: i32 = 0;                                  // items are first stored in reading order
    while (true) {
        var n: i64 = dir_next(d, buf, NAME_MAX, &kind[0]);
        if (n < 0) { break; }
        if ((n == 1 && buf[0] == 46) || (n == 2 && buf[0] == 46 && buf[1] == 46)) { continue; }
        var is_dir: i32 = kind[0];
        if (is_dir < 0) {                              // the file system did not say: a directory is one we can open
            is_dir = 0;
            if (join_path(full, NAME_MAX * 2, p, buf)) {
                var probe: ptr<u8> = dir_open(full);
                if (probe != null) { is_dir = 1; dir_close(probe); }
            }
        }
        if (l.used + n + 1 > l.cap) {
            var cap: i64 = l.cap * 2;
            while (l.used + n + 1 > cap) { cap = cap * 2; }
            l.names = mem_realloc(l.names, l.cap, cap);
            l.cap = cap;
        }
        if (raw == l.cap_items) { grow_items(l); }
        var k: i64 = 0;
        while (k <= n) { l.names[l.used + k] = buf[k]; k += 1; }
        l.offs[raw] = l.used as i32;
        l.dirs[raw] = is_dir as u8;
        l.used += n + 1;
        raw += 1;
    }
    dir_close(d);
    mem_free(buf, NAME_MAX);
    mem_free(full, NAME_MAX * 2);
    // insertion sort of (offs, dirs): folders first, then by name
    var i: i32 = 1;
    while (i < raw) {
        var off: i32 = l.offs[i];
        var dr: u8 = l.dirs[i];
        var j: i32 = i - 1;
        while (j >= 0 && before(l, off, dr, l.offs[j], l.dirs[j])) {
            l.offs[j + 1] = l.offs[j];
            l.dirs[j + 1] = l.dirs[j];
            j -= 1;
        }
        l.offs[j + 1] = off;
        l.dirs[j + 1] = dr;
        i += 1;
    }
    l.count = raw;
    return true;
}

// ---- paths ------------------------------------------------------------------------------------

// The current directory into buf (NUL-terminated); false when it cannot be found or does not fit.
pub fun path_cwd(buf: ptr<u8>, cap: i64) -> bool {
    return env_getcwd(buf, cap) >= 0;
}

// Appends "/name" to the path in buf (no second slash after a trailing one); false when it does not fit.
pub fun path_push(buf: ptr<u8>, cap: i64, name: str) -> bool {
    var n: i64 = 0;
    while (buf[n] != 0) { n += 1; }
    var s: ptr<u8> = name as ptr<u8>;
    var len: i64 = 0;
    while (s[len] != 0) { len += 1; }
    var slash: i64 = 1;
    if (n > 0 && buf[n - 1] == 47) { slash = 0; }
    if (n + slash + len + 1 > cap) { return false; }
    if (slash == 1) { buf[n] = 47; n += 1; }
    var i: i64 = 0;
    while (i <= len) { buf[n + i] = s[i]; i += 1; }
    return true;
}

// Cuts the last component off the path in buf: "/a/b" -> "/a", "/a" -> "/", "C:/a" -> "C:/". A path
// that is already a root stays. A relative path without a slash ("docs") becomes ".".
pub fun path_pop(buf: ptr<u8>) {
    var n: i64 = 0;
    while (buf[n] != 0) { n += 1; }
    while (n > 1 && buf[n - 1] == 47) { n -= 1; }      // a trailing slash is not a component
    var i: i64 = n;
    while (i > 0 && buf[i - 1] != 47) { i -= 1; }      // the start of the last component
    if (i == 0) { buf[0] = 46; buf[1] = 0; return; }   // "docs": nothing before it
    if (i == 1 || (i == 3 && buf[1] == 58)) { buf[i] = 0; return; }   // "/a" -> "/", "C:/a" -> "C:/"
    buf[i - 1] = 0;
}
