// SPDX-License-Identifier: MPL-2.0
//
// wjson's Wave API (third_party/wjson/src/ffi.wave) imports one C function,
// wjn_console_utf8, which its C++ layer implements: it switches a Windows console
// to UTF-8 and does nothing elsewhere. Wui programs do not need the C++ layer,
// so this module provides the symbol itself - import it in any program that uses
// wjson:
//
//   import("wui::wjson_glue");
//
// (Programs that link wjson's own libwjson_native.a must not import it.)

export(c, "wjn_console_utf8") fun wjn_console_utf8() -> i32 {
    return 0;
}
