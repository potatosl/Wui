// SPDX-License-Identifier: MPL-2.0
//
// Frame-time benchmark: builds a text-heavy view (Latin + Hangul, buttons,
// inputs) and times its parts separately - building the tree, layout, draw-list
// generation and rasterization - over many frames. Run with:  wavec run build.wave
// with WUI_TASK=bench (WUI_BENCH_FRAMES sets the frame count).

import("wui")::{Ui, ui_new, ui_free, ui_clear, ui_column, ui_row, ui_text, ui_button, ui_input, ui_input_set,
                ui_layout, ui_render, ui_set_pointer, UI_ROOT};
import("wui::core")::{core_paint, core_cmds};
import("wui::render")::{render};
import("wui::core")::{core_fe};
import("std::mem::alloc")::{mem_alloc, mem_free};
import("std::time::clock")::{time_now_monotonic_ns};

extern(c, "getenv") fun c_getenv(name: ptr<u8>) -> ptr<u8>;

const W: i32 = 900;
const H: i32 = 700;

fun put_str(buf: ptr<u8>, at: i64, s: str) -> i64 {
    var p: ptr<u8> = s as ptr<u8>;
    var n: i64 = at;
    var i: i64 = 0;
    while (p[i] != 0) { buf[n] = p[i]; n += 1; i += 1; }
    return n;
}

fun put_int(buf: ptr<u8>, at: i64, v: i32) -> i64 {
    if (v >= 10) {
        var m: i64 = put_int(buf, at, v / 10);
        buf[m] = (48 + v % 10) as u8;
        return m + 1;
    }
    buf[at] = (48 + v) as u8;
    return at + 1;
}

fun build(ui: ptr<Ui>, line: ptr<u8>) {
    ui_clear(ui);
    var page: i32 = ui_column(ui, UI_ROOT, 12, 4);
    var i: i32 = 0;
    while (i < 36) {
        var n: i64 = put_str(line, 0, "Line ");
        n = put_int(line, n, i);
        n = put_str(line, n, ": The quick brown fox jumps over the lazy dog / 빠른 갈색 여우가 게으른 개를 뛰어넘는다");
        line[n] = 0;
        ui_text(ui, page, line as str);
        i += 1;
    }
    var row: i32 = ui_row(ui, page, 0, 8);
    ui_button(ui, row, "OK", 1);
    ui_button(ui, row, "취소 / Cancel", 2);
    ui_input(ui, row, 1, "name / 이름");
}

fun ms(ns: i64) -> i64 { return ns / 1000; }          // microseconds, for readability

fun main() {
    var frames: i64 = 200;
    var env: ptr<u8> = c_getenv("WUI_BENCH_FRAMES" as ptr<u8>);
    if (env != null && env[0] != 0) {
        var v: i64 = 0;
        var i: i64 = 0;
        while (env[i] >= 48 && env[i] <= 57) { v = v * 10 + ((env[i] - 48) as i64); i += 1; }
        if (v > 0) { frames = v; }
    }
    var ui: Ui = ui_new();
    var line: ptr<u8> = mem_alloc(512);
    var pixels: ptr<u32> = mem_alloc((W * H * 4) as i64) as ptr<u32>;
    ui_set_pointer(&ui, -1, -1, false);
    build(&ui, line);
    ui_input_set(&ui, 1, "typed text / 입력한 글");
    // warm up: the glyph cache and the first layout
    ui_layout(&ui, W, H);
    ui_render(&ui, pixels as ptr<u8>, W, H);

    var t_build: i64 = 0;
    var t_layout: i64 = 0;
    var t_paint: i64 = 0;
    var t_render: i64 = 0;
    var f: i64 = 0;
    while (f < frames) {
        var t0: i64 = time_now_monotonic_ns();
        build(&ui, line);
        var t1: i64 = time_now_monotonic_ns();
        ui_layout(&ui, W, H);
        var t2: i64 = time_now_monotonic_ns();
        // a different pointer position each frame, so the picture changes and is repainted
        ui_set_pointer(&ui, (f % 40) as i32, 10, false);
        core_paint(ui.ctx, W, H);
        var t3: i64 = time_now_monotonic_ns();
        var count: i64 = 0;
        var cmds: ptr<u8> = core_cmds(ui.ctx, &count);
        render(core_fe(ui.ctx), cmds, count, pixels, W, H);
        var t4: i64 = time_now_monotonic_ns();
        t_build += t1 - t0;
        t_layout += t2 - t1;
        t_paint += t3 - t2;
        t_render += t4 - t3;
        f += 1;
    }
    println("{} frames of {} x {}, average per frame:", frames, W, H);
    println("  build tree     {} us", ms(t_build / frames));
    println("  layout         {} us", ms(t_layout / frames));
    println("  draw list      {} us", ms(t_paint / frames));
    println("  rasterize      {} us", ms(t_render / frames));
    println("  total          {} us", ms((t_build + t_layout + t_paint + t_render) / frames));
    mem_free(line, 512);
    mem_free(pixels as ptr<u8>, (W * H * 4) as i64);
    ui_free(&ui);
}
