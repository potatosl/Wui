    btn(c, left, "Y", 8);
    core_layout(c, 300, 100);
    rect_is(t, "moved back inside at the bottom right", c, ov, 268, 72, 32, 28);
    rect_is(t, "and at the top left", c, left, 0, 0, 32, 28);
    core_free(c);
}

fun test_a_full_overlay_is_a_modal_backdrop(t: ptr<T>) {
    begin(t, "a_full_overlay_is_a_modal_backdrop");
    var c: ptr<Ctx> = new_ctx(t);
    var col: i32 = core_column(c, NONE, 0, 0);
    btn(c, col, "m", 1);
    var back: i32 = core_overlay(c, NONE, OVERLAY_FULL, 0, 0);
    core_style(c, back, P_BACKGROUND, 0x80000000);
    core_style(c, back, P_ALIGN, CENTER);
    core_style(c, back, P_JUSTIFY, CENTER);
    var dialog: i32 = core_column(c, back, 10, 0);
    btn(c, dialog, "OK", 7);
    core_layout(c, 300, 200);
    rect_is(t, "the backdrop is the window", c, back, 0, 0, 300, 200);
    eq(t, "nothing below it can be hit", core_hit(c, 5, 5) as i64, NONE as i64);
    eq(t, "the dialog's button", core_hit(c, 150, 100) as i64, 7);
    eq(t, "clicking the backdrop does nothing", core_click(c, 5, 5, 0) as i64, NONE as i64);
    core_free(c);
}

fun test_overlays_are_painted_last(t: ptr<T>) {
    begin(t, "overlays_are_painted_last");
    var c: ptr<Ctx> = new_ctx(t);
    var ov: i32 = core_overlay(c, NONE, OVERLAY_AT, 20, 10);        // made FIRST, still painted last
    core_style(c, ov, P_BACKGROUND, 0xFF112233);
    btn(c, ov, "X", 9);
    var col: i32 = core_column(c, NONE, 0, 0);
    txt(c, col, "main");
    core_layout(c, 300, 100);
    var cs: Cmds = paint(c, 300, 100);
    var main_text: i64 = find_kind(&cs, CMD_TEXT);
    var over: i64 = find_color(&cs, 0xFF112233);
    ok(t, "the main tree's text", main_text >= 0);
    ok(t, "the overlay's background", over >= 0);
    ok(t, "the overlay is drawn after the main tree", over > main_text);
    core_free(c);
}

fun test_tab_stays_inside_the_topmost_overlay(t: ptr<T>) {
    begin(t, "tab_stays_inside_the_topmost_overlay");
