    btn(c, col, "m2", 2);
    var ov: i32 = core_overlay(c, NONE, OVERLAY_AT, 100, 0);
    btn(c, ov, "a", 20);
    btn(c, ov, "b", 21);
    core_layout(c, 300, 200);
    key(c, KEY_TAB, 0);
    eq(t, "the first one in the overlay", core_focused_msg(c) as i64, 20);
    key(c, KEY_TAB, 0);
    eq(t, "the second", core_focused_msg(c) as i64, 21);
    key(c, KEY_TAB, 0);
    eq(t, "wraps inside the overlay, never to the main tree", core_focused_msg(c) as i64, 20);
    key(c, KEY_TAB, SHIFT);
    eq(t, "and backwards", core_focused_msg(c) as i64, 21);
    core_free(c);
}

fun test_an_overlay_takes_the_wheel(t: ptr<T>) {
    begin(t, "an_overlay_takes_the_wheel");
    var c: ptr<Ctx> = new_ctx(t);
    var sb: i32 = rebuild(c, 10);                           // the 100 px scroll box
    var ov: i32 = core_overlay(c, NONE, OVERLAY_AT, 0, 0);
    core_style(c, ov, P_PADDING, 30);
    txt(c, ov, "a panel over the list");
    core_layout(c, 200, 300);
    eq(t, "the wheel over the overlay does not reach the list", core_scroll(c, 10, 10, 1) as i64, 0);
    eq(t, "nor does a key aimed at it", core_scroll_get(c, 7) as i64, 0);
    eq(t, "the wheel elsewhere on the list works", core_scroll(c, 190, 90, 1) as i64, 1);
    core_free(c);
}

// ---- drop-down ----------------------------------------------------------------------------------

const OPTIONS: str = "Red\nGreen\nBlue";

// A column (padding 10) with a drop-down id 3 at (10, 10), 200 x 26, and a button "below" (msg 5) under where the list opens.
fun dd_fixture(c: ptr<Ctx>) -> i32 {
    core_clear(c);
    var col: i32 = core_column(c, NONE, 10, 0);
    var dd: i32 = core_dropdown(c, col, 3, OPTIONS as ptr<u8>, slen(OPTIONS));
    var gap: i32 = bx(c, col, 10, 20, 0);
    btn(c, col, "below", 5);                                // at (10, 56)
    core_layout(c, 300, 200);
    return dd;
}

// Number of CMD_TEXT commands whose text is `want`.
fun text_count(cs: ptr<Cmds>, want: str) -> i32 {
    var k: i32 = 0;
    var w: ptr<u8> = want as ptr<u8>;
    var n: i64 = slen(want);
    var i: i64 = 0;
    while (i < cs.n) {
        var d: ptr<DrawCmd> = cmd(cs, i);
        if (d.kind == CMD_TEXT && d.text_len == n) {
            var same: bool = true;
            var j: i64 = 0;
            while (j < n) { if (d.text[j] != w[j]) { same = false; } j += 1; }
            if (same) { k += 1; }
        }
        i += 1;
    }
    return k;
}

// ---- tooltips -----------------------------------------------------------------------------------

const TIP: str = "Hint";

// A column (padding 10) with a button "go" (msg 1) at (10, 10) that has a tooltip, and a button "two" (msg 2) right under it.
fun tip_fixture(c: ptr<Ctx>) {
    core_clear(c);
    var col: i32 = core_column(c, NONE, 10, 0);
    var b: i32 = btn(c, col, "go", 1);
    core_tooltip(c, b, TIP as ptr<u8>, slen(TIP));
    btn(c, col, "two", 2);
    core_layout(c, 300, 200);
}

fun test_a_tooltip_shows_after_the_pointer_rests(t: ptr<T>) {
    begin(t, "a_tooltip_shows_after_the_pointer_rests");
    var c: ptr<Ctx> = new_ctx(t);
    core_set_time(c, 1000);
    core_set_pointer(c, 15, 15, false);
    tip_fixture(c);
    var cs: Cmds = paint(c, 300, 200);
    eq(t, "not shown at once", text_count(&cs, "Hint") as i64, 0);
    core_set_time(c, 1300);
    tip_fixture(c);
    cs = paint(c, 300, 200);
    eq(t, "nor after 300 ms", text_count(&cs, "Hint") as i64, 0);
    eq(t, "the loop is told to wake up when it is due", core_wake_ms(c) as i64, 200);
    core_set_time(c, 1500);
    tip_fixture(c);
    cs = paint(c, 300, 200);
    eq(t, "shown after 500 ms", text_count(&cs, "Hint") as i64, 1);
    eq(t, "no more wake-up needed", core_wake_ms(c) as i64, NONE as i64);
    eq(t, "it does not block what is under it", core_hit(c, 29, 45) as i64, 2);
    core_free(c);
}

fun test_a_tooltip_goes_when_the_pointer_leaves_or_clicks(t: ptr<T>) {
    begin(t, "a_tooltip_goes_when_the_pointer_leaves_or_clicks");
    var c: ptr<Ctx> = new_ctx(t);
    core_set_time(c, 0);
    core_set_pointer(c, 15, 15, false);
    tip_fixture(c);
    paint(c, 300, 200);
    core_set_time(c, 600);
    tip_fixture(c);
    var cs: Cmds = paint(c, 300, 200);
    eq(t, "shown", text_count(&cs, "Hint") as i64, 1);
    core_set_pointer(c, 250, 150, false);
    tip_fixture(c);
    cs = paint(c, 300, 200);
    eq(t, "gone when the pointer leaves", text_count(&cs, "Hint") as i64, 0);
    core_set_time(c, 700);
    core_set_pointer(c, 15, 15, false);
    tip_fixture(c);
    paint(c, 300, 200);
    core_set_time(c, 1300);
    tip_fixture(c);
    cs = paint(c, 300, 200);
    eq(t, "back after resting again", text_count(&cs, "Hint") as i64, 1);
    eq(t, "the click still reaches the button", core_click(c, 15, 15, 0) as i64, 1);
    tip_fixture(c);
    cs = paint(c, 300, 200);
    eq(t, "a click hides it", text_count(&cs, "Hint") as i64, 0);
    core_free(c);
}

// ---- menus --------------------------------------------------------------------------------------

const FILE_MENU: str = "File\nOpen\nSave\n-\nQuit";
const EDIT_MENU: str = "Edit\nCopy\nPaste";

// A row (the bar) at (0, 0) with two menus: File (id 20, messages 100..) = node 1 and Edit (id 21, messages 200..) = node 2.
fun menu_fixture(c: ptr<Ctx>) {
    core_clear(c);
    var bar: i32 = core_row(c, NONE, 0, 0);
    core_menu(c, bar, 20, FILE_MENU as ptr<u8>, slen(FILE_MENU), 100);
    core_menu(c, bar, 21, EDIT_MENU as ptr<u8>, slen(EDIT_MENU), 200);
    btn(c, bar, "after", 7);
    core_layout(c, 300, 200);
}

fun test_a_menu_shows_only_its_label(t: ptr<T>) {
    begin(t, "a_menu_shows_only_its_label");
    var c: ptr<Ctx> = new_ctx(t);
    menu_fixture(c);
    ok(t, "the menus sit side by side", rc(c, 2, 0) == rc(c, 1, 0) + rc(c, 1, 2));
    var cs: Cmds = paint(c, 300, 200);
    eq(t, "the label is drawn", text_count(&cs, "File") as i64, 1);
    eq(t, "the items are not", text_count(&cs, "Open") as i64, 0);
    eq(t, "the options text is not drawn as one string", text_count(&cs, FILE_MENU) as i64, 0);
    eq(t, "no list is open", core_dropdown_open(c) as i64, NONE as i64);
    core_free(c);
}

fun test_a_menu_opens_and_yields_a_message(t: ptr<T>) {
    begin(t, "a_menu_opens_and_yields_a_message");
    var c: ptr<Ctx> = new_ctx(t);
    menu_fixture(c);
    var fx: i32 = rc(c, 1, 0) + 4;
    var bottom: i32 = rc(c, 1, 1) + rc(c, 1, 3);
    eq(t, "a click on the label opens it", core_click(c, fx, 5, 0) as i64, NONE as i64);
    eq(t, "open", core_dropdown_open(c) as i64, 20);
    menu_fixture(c);
    var cs: Cmds = paint(c, 300, 200);
    eq(t, "items are listed", (text_count(&cs, "Open") + text_count(&cs, "Save") + text_count(&cs, "Quit")) as i64, 3);
    eq(t, "the label is not repeated in the list", text_count(&cs, "File") as i64, 1);
    // list: frame 3 px, rows of 22 px (Open, Save), then a 9 px separator, then Quit
    eq(t, "the second item", core_click(c, fx, bottom + 3 + 22 + 5, 0) as i64, 101);
    eq(t, "picking closes the menu", core_dropdown_open(c) as i64, NONE as i64);
    menu_fixture(c);
    core_click(c, fx, 5, 0);
    menu_fixture(c);
    eq(t, "the last item (the separator counts)", core_click(c, fx, bottom + 3 + 22 + 22 + 9 + 5, 0) as i64, 103);
    menu_fixture(c);
    core_click(c, fx, 5, 0);
    menu_fixture(c);
    eq(t, "a click on the separator picks nothing", core_click(c, fx, bottom + 3 + 22 + 22 + 4, 0) as i64, NONE as i64);
    eq(t, "and closes", core_dropdown_open(c) as i64, NONE as i64);
    core_free(c);
}

fun test_menus_switch_on_hover_while_one_is_open(t: ptr<T>) {
    begin(t, "menus_switch_on_hover_while_one_is_open");
    var c: ptr<Ctx> = new_ctx(t);
    menu_fixture(c);
    core_set_pointer(c, rc(c, 2, 0) + 4, 5, false);
    eq(t, "nothing opens by hovering alone", core_dropdown_open(c) as i64, NONE as i64);
    core_click(c, rc(c, 1, 0) + 4, 5, 0);
    menu_fixture(c);
    core_set_pointer(c, rc(c, 2, 0) + 4, 5, false);
    eq(t, "hovering Edit opens it instead", core_dropdown_open(c) as i64, 21);
    eq(t, "and gives it the focus", core_focused(c) as i64, 21);
    core_set_pointer(c, rc(c, 3, 0) + 4, 5, false);
    eq(t, "a button in the bar does not switch it", core_dropdown_open(c) as i64, 21);
    core_free(c);
}

fun test_menu_keyboard(t: ptr<T>) {
    begin(t, "menu_keyboard");
    var c: ptr<Ctx> = new_ctx(t);
    menu_fixture(c);
    key(c, KEY_TAB, 0);
    eq(t, "Tab focuses the first menu", core_focused(c) as i64, 20);
    eq(t, "Enter opens it", key(c, KEY_ENTER, 0) as i64, 0);
    eq(t, "open", core_dropdown_open(c) as i64, 20);
    menu_fixture(c);
    eq(t, "Enter picks the first item", key(c, KEY_ENTER, 0) as i64, INPUT_ACTIVATED as i64);
    eq(t, "its message", core_activated(c) as i64, 100);
    eq(t, "closed", core_dropdown_open(c) as i64, NONE as i64);
    key(c, KEY_DOWN, 0);                                    // opens it again, on the first item
    menu_fixture(c);
    key(c, KEY_DOWN, 0);                                    // Save
    key(c, KEY_DOWN, 0);                                    // skips the separator: Quit
    key(c, KEY_DOWN, 0);                                    // stays on the last
    eq(t, "Enter picks Quit", key(c, KEY_ENTER, 0) as i64, INPUT_ACTIVATED as i64);
    eq(t, "message", core_activated(c) as i64, 103);
    key(c, KEY_ENTER, 0);
    menu_fixture(c);
    key(c, KEY_RIGHT, 0);
    eq(t, "Right goes to the next menu", core_dropdown_open(c) as i64, 21);
    eq(t, "Right wraps around", (key(c, KEY_RIGHT, 0) + core_dropdown_open(c)) as i64, 20);
    key(c, KEY_LEFT, 0);
    eq(t, "Left goes back", core_dropdown_open(c) as i64, 21);
    key(c, KEY_ESCAPE, 0);
    eq(t, "Escape closes", core_dropdown_open(c) as i64, NONE as i64);
    core_free(c);
}

// ---- left-aligned buttons -----------------------------------------------------------------------

fun test_a_left_button_starts_at_the_edge_and_is_cut(t: ptr<T>) {
    begin(t, "a_left_button_starts_at_the_edge_and_is_cut");
    var c: ptr<Ctx> = new_ctx(t);
    core_clear(c);
    var col: i32 = core_column(c, NONE, 10, 0);
    var a: i32 = btn(c, col, "ab", 1);
    core_style(c, a, P_WIDTH, 100);
    var b: i32 = btn(c, col, "ab", 2);
    core_style(c, b, P_WIDTH, 100);
    core_left(c, b);
    var long: i32 = btn(c, col, "a very long label indeed", 3);
    core_style(c, long, P_WIDTH, 60);
    core_layout(c, 300, 200);
    var cs: Cmds = paint(c, 300, 200);
    var centred: i64 = -1;
    var left: i64 = -1;
    var cut: i64 = -1;
    var i: i64 = 0;
    while (i < cs.n) {
        var d: ptr<DrawCmd> = cmd(&cs, i);
        if (d.kind == CMD_TEXT && d.text_len == 2 && centred < 0) { centred = d.x as i64; }
        else if (d.kind == CMD_TEXT && d.text_len == 2) { left = d.x as i64; }
        if (d.kind == CMD_TEXT && d.text_len == 24) { cut = d.x as i64; }
        i += 1;
    }
    eq(t, "a plain button centres its label", centred, (10 + (100 - 16) / 2) as i64);
    eq(t, "a left button starts 4 px in", left, 14);
    eq(t, "a label too long for its button starts at the left too", cut, 14);
    ok(t, "and is clipped", count_kind(&cs, CMD_CLIP) >= 2);
    core_free(c);
}

// ---- colour text ---------------------------------------------------------------------------------

fun parse_color(t: ptr<T>, text: str, want: i64) {
    var c: array<u32, 1>;
    c[0] = 7;
    eq(t, text, color_parse(text, &c[0]) as i64, 1);
    eq(t, text, c[0] as i64, want);
}

fun reject_color(t: ptr<T>, text: str) {
    var c: array<u32, 1>;
    c[0] = 7;
    eq(t, text, color_parse(text, &c[0]) as i64, 0);
    eq(t, text, c[0] as i64, 7);
}

fun test_colour_text(t: ptr<T>) {
    begin(t, "colour_text");
    parse_color(t, "#1E3A8A", 0xFF1E3A8A);
    parse_color(t, "#801E3A8A", 0x801E3A8A);
    parse_color(t, "#abcdef", 0xFFABCDEF);
    parse_color(t, "#F80", 0xFFFF8800);
    parse_color(t, "#fff", 0xFFFFFFFF);
    parse_color(t, "#8F00", 0x88FF0000);
    parse_color(t, "#000000", 0xFF000000);
    reject_color(t, "1E3A8A");
    reject_color(t, "#");
    reject_color(t, "#12");
    reject_color(t, "#12345");
    reject_color(t, "#1234567");
    reject_color(t, "#123456789");
    reject_color(t, "#12G456");
    reject_color(t, "#1E3A8A ");
    reject_color(t, "");
}

fun test_dropdown_layout_value_and_paint(t: ptr<T>) {
    begin(t, "dropdown_layout_value_and_paint");
    var c: ptr<Ctx> = new_ctx(t);
    var dd: i32 = dd_fixture(c);
    rect_is(t, "an input's size", c, dd, 10, 10, 200, 26);
    eq(t, "starts at the first option", core_dropdown_get(c, 3) as i64, 0);
    core_dropdown_set(c, 3, 2);
    dd_fixture(c);
    eq(t, "set and kept", core_dropdown_get(c, 3) as i64, 2);
    core_dropdown_set(c, 3, 99);
    dd_fixture(c);
    eq(t, "clamped to the last option", core_dropdown_get(c, 3) as i64, 2);
    var cs: Cmds = paint(c, 300, 200);
    eq(t, "the chosen option is shown", text_count(&cs, "Blue") as i64, 1);
    eq(t, "the others are not", text_count(&cs, "Red") as i64, 0);
    eq(t, "a chevron: two strokes", count_kind(&cs, CMD_LINE) as i64, 2);
    eq(t, "the list is closed", core_dropdown_open(c) as i64, NONE as i64);
    core_free(c);
}

fun test_dropdown_opens_and_picks_with_the_mouse(t: ptr<T>) {
    begin(t, "dropdown_opens_and_picks_with_the_mouse");
    var c: ptr<Ctx> = new_ctx(t);
    dd_fixture(c);
    eq(t, "a click returns no message", core_click(c, 100, 20, 0) as i64, NONE as i64);
    eq(t, "the list is open", core_dropdown_open(c) as i64, 3);
    eq(t, "the drop-down has the focus", core_focused(c) as i64, 3);
    dd_fixture(c);                                          // the next frame: the list exists
    var cs: Cmds = paint(c, 300, 200);
    eq(t, "all three options are listed", (text_count(&cs, "Red") + text_count(&cs, "Green") + text_count(&cs, "Blue")) as i64, 4);   // Red twice: the box and the list
    // the list: x 10, y 38 (under the box, a 2 px gap), 3 px frame, rows of 22 px
    eq(t, "the button underneath is covered", core_hit(c, 20, 80) as i64, NONE as i64);
    eq(t, "clicking the third row", core_click(c, 50, 41 + 44 + 5, 0) as i64, NONE as i64);
    eq(t, "picks Blue", core_dropdown_get(c, 3) as i64, 2);
    eq(t, "and closes the list", core_dropdown_open(c) as i64, NONE as i64);
    dd_fixture(c);
    cs = paint(c, 300, 200);
    eq(t, "the box now shows Blue", text_count(&cs, "Blue") as i64, 1);
    eq(t, "the button below is reachable again", core_hit(c, 20, 70) as i64, 5);
    core_free(c);
}

fun test_clicking_elsewhere_closes_the_list(t: ptr<T>) {
    begin(t, "clicking_elsewhere_closes_the_list");
    var c: ptr<Ctx> = new_ctx(t);
    dd_fixture(c);
    core_click(c, 100, 20, 0);
    dd_fixture(c);
    eq(t, "open", core_dropdown_open(c) as i64, 3);
    eq(t, "a click outside the list", core_click(c, 280, 180, 0) as i64, NONE as i64);
    eq(t, "closes it", core_dropdown_open(c) as i64, NONE as i64);
    eq(t, "the choice is unchanged", core_dropdown_get(c, 3) as i64, 0);
    core_click(c, 100, 20, 0);                              // open again
    dd_fixture(c);
    core_click(c, 100, 20, 0);                              // a click on its own box
    eq(t, "closes it, and does not reopen", core_dropdown_open(c) as i64, NONE as i64);
    core_free(c);
}

fun test_dropdown_keyboard(t: ptr<T>) {
    begin(t, "dropdown_keyboard");
    var c: ptr<Ctx> = new_ctx(t);
    dd_fixture(c);
    key(c, KEY_TAB, 0);
    eq(t, "Tab focuses it", core_focused(c) as i64, 3);
    eq(t, "Down changes the choice while closed", key(c, KEY_DOWN, 0) as i64, INPUT_CHANGED as i64);
    eq(t, "Green", core_dropdown_get(c, 3) as i64, 1);
    key(c, KEY_END, 0);
    eq(t, "End: the last", core_dropdown_get(c, 3) as i64, 2);
    eq(t, "Down at the end", key(c, KEY_DOWN, 0) as i64, 0);
    key(c, KEY_HOME, 0);
    eq(t, "Home: the first", core_dropdown_get(c, 3) as i64, 0);
    eq(t, "Up at the start", key(c, KEY_UP, 0) as i64, 0);
    eq(t, "Enter opens the list", key(c, KEY_ENTER, 0) as i64, 0);
    eq(t, "it is open", core_dropdown_open(c) as i64, 3);
    dd_fixture(c);
    key(c, KEY_DOWN, 0);
    key(c, KEY_DOWN, 0);
    eq(t, "moving the highlight does not change the choice", core_dropdown_get(c, 3) as i64, 0);
    eq(t, "Enter picks the highlighted one", key(c, KEY_ENTER, 0) as i64, INPUT_CHANGED as i64);
    eq(t, "Blue", core_dropdown_get(c, 3) as i64, 2);
    eq(t, "and closes", core_dropdown_open(c) as i64, NONE as i64);
    key(c, KEY_ENTER, 0);
    dd_fixture(c);
    key(c, KEY_UP, 0);
    eq(t, "Escape closes without picking", key(c, KEY_ESCAPE, 0) as i64, 0);
    eq(t, "closed", core_dropdown_open(c) as i64, NONE as i64);
    eq(t, "still Blue", core_dropdown_get(c, 3) as i64, 2);
    eq(t, "Space opens", feed(c, " ") as i64, 0);
    eq(t, "open", core_dropdown_open(c) as i64, 3);
    dd_fixture(c);
    eq(t, "Space again picks the highlighted row", feed(c, " ") as i64, 0);
    eq(t, "closed", core_dropdown_open(c) as i64, NONE as i64);
    key(c, KEY_ENTER, 0);
    key(c, KEY_TAB, 0);
    eq(t, "Tab closes an open list", core_dropdown_open(c) as i64, NONE as i64);
    core_free(c);
}

fun test_the_list_is_built_once_and_follows_the_tree(t: ptr<T>) {
    begin(t, "the_list_is_built_once_and_follows_the_tree");
    var c: ptr<Ctx> = new_ctx(t);
    dd_fixture(c);
    core_click(c, 100, 20, 0);
    dd_fixture(c);
    core_layout(c, 300, 200);                               // laying out again must not build a second list
    core_layout(c, 300, 200);
    var cs: Cmds = paint(c, 300, 200);
    eq(t, "Green is listed once", text_count(&cs, "Green") as i64, 1);
    // the drop-down leaves the tree: the list closes with it
    core_clear(c);
    var col: i32 = core_column(c, NONE, 10, 0);
    btn(c, col, "only a button", 1);
    core_layout(c, 300, 200);
    eq(t, "closed", core_dropdown_open(c) as i64, NONE as i64);
    core_free(c);
}

fun test_dropdown_highlight_and_choice_are_marked(t: ptr<T>) {
    begin(t, "dropdown_highlight_and_choice_are_marked");
    var c: ptr<Ctx> = new_ctx(t);
    core_dropdown_set(c, 3, 1);                             // Green is chosen
    dd_fixture(c);
    core_click(c, 100, 20, 0);
    dd_fixture(c);
    key(c, KEY_DOWN, 0);                                    // the highlight moves to Blue
    dd_fixture(c);
    var cs: Cmds = paint(c, 300, 200);
    eq(t, "one highlighted row", count_color(&cs, core_theme(c).selection) as i64, 1);
    var hl: i64 = find_color(&cs, core_theme(c).selection);
    if (hl >= 0) { eq(t, "it is the third row (y 3 + 38 + 44)", cmd(&cs, hl).y as i64, 41 + 44); }
    var accent_text: bool = false;
    var i: i64 = 0;
    while (i < cs.n) {
        var d: ptr<DrawCmd> = cmd(&cs, i);
        if (d.kind == CMD_TEXT && d.color == core_theme(c).accent && d.text_len == 5) { accent_text = true; }   // "Green"
        i += 1;
    }
    ok(t, "the chosen option is in the accent colour", accent_text);
    core_free(c);
}

// ---- multi-line text area ---------------------------------------------------------------------

// A column (padding 10) with a text area, id 4, `rows` lines tall: (10, 10), 200 x (16 * rows + 10).
fun ta_fixture(c: ptr<Ctx>, rows: i32) -> i32 {
    core_clear(c);
    var col: i32 = core_column(c, NONE, 10, 0);
    var ta: i32 = core_textarea(c, col, 4, "notes" as ptr<u8>, 5, rows);
    core_layout(c, 300, 200);
    return ta;
}

fun set_text(c: ptr<Ctx>, text: str) {
    core_input_set(c, 4, text as ptr<u8>, slen(text));
}

fun test_textarea_layout_and_newlines(t: ptr<T>) {
    begin(t, "textarea_layout_and_newlines");
    var c: ptr<Ctx> = new_ctx(t);
    var ta: i32 = ta_fixture(c, 3);
    rect_is(t, "3 rows + padding", c, ta, 10, 10, 200, 58);
    core_input_focus(c, 4);
    eq(t, "typed", feed(c, "ab") as i64, INPUT_CHANGED as i64);
    eq(t, "Enter types a newline", key(c, KEY_ENTER, 0) as i64, INPUT_CHANGED as i64);
    feed(c, "cd");
    input_is(t, c, 4, "ab\ncd");
    eq(t, "Ctrl+Enter submits instead", key(c, KEY_ENTER, CTRL) as i64, INPUT_SUBMIT as i64);
    input_is(t, c, 4, "ab\ncd");
    feed(c, "x\ny");                                       // a paste with a newline keeps it
    input_is(t, c, 4, "ab\ncdx\ny");
    feed(c, "\x07");                                       // other control characters are still dropped
    input_is(t, c, 4, "ab\ncdx\ny");
    core_free(c);
}

fun test_textarea_up_and_down_keep_the_column(t: ptr<T>) {
    begin(t, "textarea_up_and_down_keep_the_column");
    var c: ptr<Ctx> = new_ctx(t);
    ta_fixture(c, 3);
    set_text(c, "hello\nhi\nworld");
    core_input_focus(c, 4);                                 // the caret is at the end: line 3, column 5
    key(c, KEY_UP, 0);                                      // "hi" is shorter: the end of it
    key(c, KEY_UP, 0);                                      // the column 5 is remembered: back to column 5 of "hello"
    key(c, KEY_DOWN, 0);
    key(c, KEY_DOWN, 0);
    feed(c, "?");
    input_is(t, c, 4, "hello\nhi\nworld?");
    set_text(c, "hello\nhi\nworld");
    key(c, KEY_UP, 0);
    feed(c, "!");
    input_is(t, c, 4, "hello\nhi!\nworld");
    key(c, KEY_UP, 0);                                      // typing forgets the remembered column
    key(c, KEY_UP, 0);
    feed(c, "^");
    input_is(t, c, 4, "^hello\nhi!\nworld");
    core_free(c);
}

fun test_textarea_home_end_and_selection(t: ptr<T>) {
    begin(t, "textarea_home_end_and_selection");
    var c: ptr<Ctx> = new_ctx(t);
    ta_fixture(c, 3);
    set_text(c, "ab\ncd");
    core_input_focus(c, 4);
    key(c, KEY_HOME, 0);                                    // the start of the line
    feed(c, "|");
    input_is(t, c, 4, "ab\n|cd");
    key(c, KEY_HOME, CTRL);                                 // the start of the text
    feed(c, "^");
    input_is(t, c, 4, "^ab\n|cd");
    key(c, KEY_END, 0);                                     // the end of the first line
    feed(c, "$");
    input_is(t, c, 4, "^ab$\n|cd");
    key(c, KEY_END, CTRL);
    feed(c, "!");
    input_is(t, c, 4, "^ab$\n|cd!");
    set_text(c, "ab\ncd");
    key(c, KEY_HOME, CTRL);
    key(c, KEY_RIGHT, 0);
    key(c, KEY_DOWN, SHIFT);                                // a selection across the line break
    selection_is(t, c, "b\nc");
    core_free(c);
}

fun test_textarea_mouse(t: ptr<T>) {
    begin(t, "textarea_mouse");
    var c: ptr<Ctx> = new_ctx(t);
    ta_fixture(c, 3);
    set_text(c, "abc\ndef\nghi");
    // text starts at x 10 + 6, the first line at y 10 + 5, each line 16 px
    eq(t, "a click in the second line, after two characters", core_click(c, 16 + 16 + 1, 15 + 16 + 3, 0) as i64, NONE as i64);
    eq(t, "focused", core_focused(c) as i64, 4);
    feed(c, "_");
    input_is(t, c, 4, "abc\nde_f\nghi");
    core_click(c, 200, 15 + 32 + 3, 0);                     // far right of the third line: its end
    feed(c, "!");
    input_is(t, c, 4, "abc\nde_f\nghi!");
    core_click(c, 16, 12, 0);                               // above the first line's text, inside the box: the start of the first line
    feed(c, "<");
    input_is(t, c, 4, "<abc\nde_f\nghi!");
    core_click(c, 16, 15 + 3, 0);                           // press at the start of line 1 and drag down to line 3
    eq(t, "drag", core_drag(c, 16 + 16, 15 + 32 + 3) as i64, 1);
    selection_is(t, c, "<abc\nde_f\ngh");
    core_free(c);
}

fun test_textarea_scrolls_with_the_caret_and_the_wheel(t: ptr<T>) {
    begin(t, "textarea_scrolls_with_the_caret_and_the_wheel");
    var c: ptr<Ctx> = new_ctx(t);
    ta_fixture(c, 3);
    set_text(c, "1\n2\n3\n4\n5\n6");
    core_input_focus(c, 4);                                 // the caret is on line 6, below the three visible rows
    var cs: Cmds = paint(c, 300, 200);
    eq(t, "line 6 is shown", text_count(&cs, "6") as i64, 1);
    eq(t, "line 1 is scrolled out", text_count(&cs, "1") as i64, 0);
    var caret: i64 = -1;
    var i: i64 = 0;
    while (i < cs.n) { if (cmd(&cs, i).kind == CMD_FILL && cmd(&cs, i).w == 1 && cmd(&cs, i).h == 16) { caret = i; } i += 1; }
    ok(t, "the caret is inside the box", caret >= 0 && cmd(&cs, caret).y >= 10 && cmd(&cs, caret).y + 16 <= 68);
    eq(t, "the wheel scrolls it back up", core_scroll(c, 20, 20, -1) as i64, 1);
    cs = paint(c, 300, 200);
    eq(t, "line 1 is back", text_count(&cs, "1") as i64, 1);
    eq(t, "(and the view does not snap back to the caret)", text_count(&cs, "1") as i64, 1);
    eq(t, "already at the top", core_scroll(c, 20, 20, -1) as i64, 0);
    core_free(c);
}

fun test_textarea_page_keys_tab_and_placeholder(t: ptr<T>) {
    begin(t, "textarea_page_keys_tab_and_placeholder");
    var c: ptr<Ctx> = new_ctx(t);
    ta_fixture(c, 3);
    var cs: Cmds = paint(c, 300, 200);
    eq(t, "an empty, unfocused area shows its hint", text_count(&cs, "notes") as i64, 1);
    set_text(c, "1\n2\n3\n4\n5\n6");
    core_input_focus(c, 4);
    key(c, KEY_HOME, CTRL);
    key(c, KEY_PAGE_DOWN, 0);                               // rows - 1 = two lines
    feed(c, "x");
    input_is(t, c, 4, "1\n2\nx3\n4\n5\n6");
    key(c, KEY_PAGE_UP, 0);
    feed(c, "y");
    input_is(t, c, 4, "1y\n2\nx3\n4\n5\n6");                 // the column (after one character) is kept
    eq(t, "Tab moves the focus out instead of typing a tab", key(c, KEY_TAB, 0) as i64, INPUT_FOCUS_MOVED as i64);
    input_is(t, c, 4, "1y\n2\nx3\n4\n5\n6");
    core_free(c);
}

// ---- font size, weight and scale ----------------------------------------------------------------

fun test_font_size_scales_measurement_and_is_inherited(t: ptr<T>) {
    begin(t, "font_size_scales_measurement_and_is_inherited");
    var c: ptr<Ctx> = new_ctx(t);                            // font-less: 16 px text = 8 px per character, 16 px high
    var col: i32 = core_column(c, NONE, 0, 0);
    var plain: i32 = txt(c, col, "abcd");
    var big: i32 = core_box(c, col);
    core_style(c, big, P_FONT_SIZE, 32);
    var inherits: i32 = txt(c, big, "abcd");
    var own: i32 = txt(c, big, "abcd");
    core_style(c, own, P_FONT_SIZE, 10);
    var deeper: i32 = core_box(c, big);
    var grandchild: i32 = txt(c, deeper, "abcd");
    core_layout(c, 300, 300);
    rect_is(t, "the default: 4 x 8 by 16", c, plain, 0, 0, 32, 16);
    eq(t, "inherited from the parent: 4 x 16 wide", rc(c, inherits, 2) as i64, 64);
    eq(t, "and 32 high", rc(c, inherits, 3) as i64, 32);
    eq(t, "an own size wins: 4 x 5", rc(c, own, 2) as i64, 20);
    eq(t, "and 10 high", rc(c, own, 3) as i64, 10);
    eq(t, "a grandchild inherits through a plain box", rc(c, grandchild, 2) as i64, 64);
    core_free(c);
}

fun test_widgets_follow_the_font_size(t: ptr<T>) {
    begin(t, "widgets_follow_the_font_size");
    var c: ptr<Ctx> = new_ctx(t);
    var col: i32 = core_column(c, NONE, 0, 0);
    core_style(c, col, P_FONT_SIZE, 32);
    var b: i32 = btn(c, col, "ok", 1);                      // 2 chars x 16 + 24 wide, 32 + 12 high
    var i: i32 = core_input(c, col, 1, null, 0);            // 32 + 10 high
    var k: i32 = chk(c, col, "x", false, 2);                // the square is 16: the 32 px line is taller
    core_layout(c, 400, 300);
    rect_is(t, "button", c, b, 0, 0, 56, 44);
    eq(t, "input height", rc(c, i, 3) as i64, 42);
    eq(t, "checkbox: 16 + 8 + one 16 px character", rc(c, k, 2) as i64, 40);
    eq(t, "checkbox height follows the line", rc(c, k, 3) as i64, 32);
    // a click in the input lands by the bigger characters (16 px each)
    core_input_set(c, 1, "abcdef" as ptr<u8>, 6);
    core_click(c, 6 + 16 * 3 + 2, rc(c, i, 1) + 5, 0);
    feed(c, "_");
    input_is(t, c, 1, "abc_def");
    core_free(c);
}

fun test_text_commands_carry_size_and_weight(t: ptr<T>) {
    begin(t, "text_commands_carry_size_and_weight");
    var c: ptr<Ctx> = new_ctx(t);
    var col: i32 = core_column(c, NONE, 0, 0);
    core_style(c, col, P_BOLD, 1);
    core_style(c, col, P_FONT_SIZE, 24);
    txt(c, col, "bold and big");
    var reg: i32 = txt(c, col, "regular again");
    core_style(c, reg, P_BOLD, 0);
    var back: i32 = txt(c, col, "inherits");
    core_style(c, back, P_BOLD, -1);
    core_layout(c, 400, 300);
    var cs: Cmds = paint(c, 400, 300);
    eq(t, "size of the first", cmd(&cs, 1).w as i64, 24);
    eq(t, "bold flag", cmd(&cs, 1).h as i64, TEXT_BOLD as i64);
    eq(t, "regular overrides a bold parent", cmd(&cs, 2).h as i64, 0);
    eq(t, "the size is still inherited", cmd(&cs, 2).w as i64, 24);
    eq(t, "-1 inherits the weight again", cmd(&cs, 3).h as i64, TEXT_BOLD as i64);
    core_free(c);
}

fun test_the_theme_sets_the_default_size(t: ptr<T>) {
    begin(t, "the_theme_sets_the_default_size");
    var c: ptr<Ctx> = new_ctx(t);
    var th: ptr<Theme> = core_theme(c);
    eq(t, "a new Ui starts with 16 px text", th.font_size as i64, 16);
    var light: Theme = Theme { bg: 0, text: 0, button: 0, button_hover: 0, button_down: 0, border: 0, field: 0, field_focus: 0,
                               placeholder: 0, selection: 0, scroll_track: 0, scroll_thumb: 0, accent: 0, check_mark: 0,
                               radius_button: 0, radius_field: 0, radius_check: 0, button_pad_x: 0, button_pad_y: 0,
                               field_pad_x: 0, field_pad_y: 0, field_width: 0, check_box: 0, check_gap: 0, scrollbar_w: 0,
                               scrollbar_min: 0, scrollbar_grab: 0, scroll_step: 0, caret_blink_ms: 0, progress_h: 0,
                               slider_thumb: 0, slider_track: 0, font_size: 0 };
    theme_light(&light);
    eq(t, "theme_light's size", light.font_size as i64, 16);
    th.font_size = 20;
    var col: i32 = core_column(c, NONE, 0, 0);
    var tx: i32 = txt(c, col, "abcd");
    core_layout(c, 300, 100);
    rect_is(t, "20 px text: 10 per character, 20 high", c, tx, 0, 0, 40, 20);
    core_free(c);
}

fun test_theme_scale_for_high_resolution_screens(t: ptr<T>) {
    begin(t, "theme_scale_for_high_resolution_screens");
    var th: Theme = Theme { bg: 0, text: 0, button: 0, button_hover: 0, button_down: 0, border: 0, field: 0, field_focus: 0,
                            placeholder: 0, selection: 0, scroll_track: 0, scroll_thumb: 0, accent: 0, check_mark: 0,
                            radius_button: 0, radius_field: 0, radius_check: 0, button_pad_x: 0, button_pad_y: 0,
                            field_pad_x: 0, field_pad_y: 0, field_width: 0, check_box: 0, check_gap: 0, scrollbar_w: 0,
                            scrollbar_min: 0, scrollbar_grab: 0, scroll_step: 0, caret_blink_ms: 0, progress_h: 0,
                            slider_thumb: 0, slider_track: 0, font_size: 0 };
    theme_light(&th);
    theme_scale(&th, 200);
    eq(t, "text size", th.font_size as i64, 32);
    eq(t, "button padding", th.button_pad_x as i64, 24);
    eq(t, "checkbox", th.check_box as i64, 32);
    eq(t, "scrollbar", th.scrollbar_w as i64, 12);
    eq(t, "input width", th.field_width as i64, 400);
    eq(t, "the caret blink time is not a size", th.caret_blink_ms as i64, 530);
    theme_light(&th);
    theme_scale(&th, 150);
    eq(t, "one and a half: 16 -> 24", th.font_size as i64, 24);
    eq(t, "6 -> 9", th.scrollbar_w as i64, 9);
    eq(t, "rounds: 3 * 1.5 = 4.5 -> 5", th.radius_check as i64, 5);
    theme_light(&th);
    theme_scale(&th, 100);
    eq(t, "100 changes nothing", th.font_size as i64, 16);
    var c: ptr<Ctx> = new_ctx(t);
    theme_light(&th);
    theme_scale(&th, 200);
    core_set_theme(c, &th);
    var col: i32 = core_column(c, NONE, 0, 0);
    var b: i32 = btn(c, col, "ok", 1);                      // 32 px text: 2 x 16 + 2 x 24 wide, 32 + 24 high
    core_layout(c, 400, 300);
    rect_is(t, "a scaled button", c, b, 0, 0, 80, 56);
    core_free(c);
}

// ---- Unicode helpers ------------------------------------------------------------------------------

fun test_unicode_classes(t: ptr<T>) {
    begin(t, "unicode_classes");
    ok(t, "ascii letter", unicode_is_alnum(97));
    ok(t, "ascii digit", unicode_is_alnum(48));
    ok(t, "space", !unicode_is_alnum(32));
    ok(t, "punctuation", !unicode_is_alnum(46));
    ok(t, "underscore", !unicode_is_alnum(95));
    ok(t, "Hangul syllable", unicode_is_alnum(0xAC00));
    ok(t, "CJK ideograph", unicode_is_alnum(0x65E5));
    ok(t, "Cyrillic", unicode_is_alnum(0x0436));
    ok(t, "circled digit one", unicode_is_alnum(0x2460));
    ok(t, "superscript two", unicode_is_alnum(0xB2));
    ok(t, "em dash", !unicode_is_alnum(0x2014));
    ok(t, "check mark", !unicode_is_alnum(0x2713));
    ok(t, "emoji", !unicode_is_alnum(0x1F600));
    ok(t, "NUL is control", unicode_is_control(0));
    ok(t, "DEL is control", unicode_is_control(0x7F));
    ok(t, "C1 control", unicode_is_control(0x9F));
    ok(t, "space is not control", !unicode_is_control(32));
    ok(t, "NBSP is not control", !unicode_is_control(0xA0));
}

