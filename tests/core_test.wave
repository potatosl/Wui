fun test_theme_metrics_reach_the_layout(t: ptr<T>) {
    begin(t, "theme_metrics_reach_the_layout");
    var c: ptr<Ctx> = new_ctx(t);
    var col: i32 = core_column(c, NONE, 0, 0);
    var b: i32 = btn(c, col, "ok", 1);
    var i: i32 = core_input(c, col, 1, null, 0);
    var k: i32 = chk(c, col, "x", false, 2);
    core_layout(c, 300, 200);
    eq(t, "default button width: 16 + 2 * 12", rc(c, b, 2) as i64, 40);
    eq(t, "default input width", rc(c, i, 2) as i64, 200);
    eq(t, "default checkbox width: 16 + 8 + 8", rc(c, k, 2) as i64, 32);
    var th: ptr<Theme> = core_theme(c);
    th.button_pad_x = 20;
    th.button_pad_y = 10;
    th.field_width = 120;
    th.field_pad_y = 8;
    th.check_box = 20;
    th.check_gap = 4;
    core_layout(c, 300, 200);
    eq(t, "wider button", rc(c, b, 2) as i64, 56);
    eq(t, "taller button: 16 + 2 * 10", rc(c, b, 3) as i64, 36);
    eq(t, "narrower input", rc(c, i, 2) as i64, 120);
    eq(t, "taller input: 16 + 2 * 8", rc(c, i, 3) as i64, 32);
    eq(t, "checkbox: 20 + 4 + 8", rc(c, k, 2) as i64, 32);
    eq(t, "checkbox height is the square", rc(c, k, 3) as i64, 20);
    core_free(c);
}

fun test_dark_theme_and_set_theme_copies(t: ptr<T>) {
    begin(t, "dark_theme_and_set_theme_copies");
    var c: ptr<Ctx> = new_ctx(t);
    var dark: Theme = Theme { bg: 0, text: 0, button: 0, button_hover: 0, button_down: 0, border: 0, field: 0, field_focus: 0,
                              placeholder: 0, selection: 0, scroll_track: 0, scroll_thumb: 0, accent: 0, check_mark: 0,
                              radius_button: 0, radius_field: 0, radius_check: 0, button_pad_x: 0, button_pad_y: 0,
                              field_pad_x: 0, field_pad_y: 0, field_width: 0, check_box: 0, check_gap: 0, scrollbar_w: 0,
                              scrollbar_min: 0, scrollbar_grab: 0, scroll_step: 0, caret_blink_ms: 0, progress_h: 0, slider_thumb: 0, slider_track: 0, font_size: 0 };
    theme_dark(&dark);
    var cur: ptr<Theme> = core_theme(c);
    ok(t, "dark differs from light", dark.bg != cur.bg);
    core_set_theme(c, &dark);
    dark.bg = 0xFF000000;                                   // changing the source later must not change the Ui
    eq(t, "the Ui kept its own copy", cur.bg as i64, 0xFF1E1E1E);
    var col: i32 = core_column(c, NONE, 0, 0);
    btn(c, col, "ok", 1);
    core_layout(c, 100, 100);
    var cs: Cmds = paint(c, 100, 100);
    eq(t, "dark background painted", cmd(&cs, 0).color as i64, 0xFF1E1E1E);
    eq(t, "dark button", cmd(&cs, 1).color as i64, 0xFF3A3A3A);
    core_free(c);
}

fun test_node_styles_win_over_the_theme(t: ptr<T>) {
    begin(t, "node_styles_win_over_the_theme");
    var c: ptr<Ctx> = new_ctx(t);
    var th: ptr<Theme> = core_theme(c);
    th.text = 0xFF111111;
    th.radius_button = 0;
    var col: i32 = core_column(c, NONE, 0, 0);
    var own: i32 = txt(c, col, "own colour");
    core_style(c, own, P_COLOR, 0xFFCC0000);
    var plain: i32 = txt(c, col, "theme colour");
    var square: i32 = btn(c, col, "square", 1);                      // radius 0 from the theme: plain fill
    var round: i32 = btn(c, col, "round", 2);
    core_style(c, round, P_RADIUS, 9);
    core_layout(c, 200, 200);
    var cs: Cmds = paint(c, 200, 200);
    eq(t, "an own colour wins", cmd(&cs, 1).color as i64, 0xFFCC0000);
    eq(t, "the theme colour otherwise", cmd(&cs, 2).color as i64, 0xFF111111);
    eq(t, "square button from the theme", count_kind(&cs, CMD_FILL) as i64, 2);   // the window and the square button
    eq(t, "round button from its own radius", count_kind(&cs, CMD_ROUND_FILL) as i64, 1);
    core_free(c);
}

fun test_scrollbar_size_and_step_come_from_the_theme(t: ptr<T>) {
    begin(t, "scrollbar_size_and_step_come_from_the_theme");
    var c: ptr<Ctx> = new_ctx(t);
    var th: ptr<Theme> = core_theme(c);
    th.scrollbar_w = 10;
    th.scroll_step = 20;
    th.scroll_thumb = 0xFF445566;
    rebuild(c, 10);
    var cs: Cmds = paint(c, 200, 300);
    var at: i64 = find_color(&cs, 0xFF445566);
    ok(t, "the thumb has the theme colour", at >= 0);
    if (at >= 0) {
        eq(t, "thumb thickness", cmd(&cs, at).w as i64, 10);
        eq(t, "thumb x: 200 - 10 - 1", cmd(&cs, at).x as i64, 189);
    }
    eq(t, "one notch = the theme's step", core_scroll(c, 10, 10, 1) as i64, 1);
    eq(t, "offset", core_scroll_get(c, 7) as i64, 20);
    core_free(c);
}

// ---- time and the caret blink ---------------------------------------------------------------

fun caret_count(cs: ptr<Cmds>) -> i32 {
    var k: i32 = 0;
    var i: i64 = 0;
    while (i < cs.n) {
        if (cmd(cs, i).kind == CMD_FILL && cmd(cs, i).w == 1 && cmd(cs, i).h == 16) { k += 1; }
        i += 1;
    }
    return k;
}

fun blink_fixture(c: ptr<Ctx>) {
    core_clear(c);
    var col: i32 = core_column(c, NONE, 10, 0);
    core_input(c, col, 7, null, 0);
    core_layout(c, 300, 100);
}

fun test_the_caret_blinks_and_typing_restarts_it(t: ptr<T>) {
    begin(t, "the_caret_blinks_and_typing_restarts_it");
    var c: ptr<Ctx> = new_ctx(t);
    blink_fixture(c);
    eq(t, "no focus: nothing to wake up for", core_wake_ms(c) as i64, NONE as i64);
    core_set_time(c, 1000);
    core_input_focus(c, 7);                                 // the blink starts now, "on"
    eq(t, "next flip in a period", core_wake_ms(c) as i64, 530);
    var cs: Cmds = paint(c, 300, 100);
    eq(t, "caret on", caret_count(&cs) as i64, 1);
    core_set_time(c, 1200);
    eq(t, "330 ms to go", core_wake_ms(c) as i64, 330);
    cs = paint(c, 300, 100);
    eq(t, "still on", caret_count(&cs) as i64, 1);
    ok(t, "an unchanged picture is detected", !core_changed(c));
    core_set_time(c, 1530);
    cs = paint(c, 300, 100);
    eq(t, "caret off", caret_count(&cs) as i64, 0);
    ok(t, "the flip is a change", core_changed(c));
    eq(t, "next flip", core_wake_ms(c) as i64, 530);
    core_set_time(c, 2060);
    cs = paint(c, 300, 100);
    eq(t, "caret on again", caret_count(&cs) as i64, 1);
    core_set_time(c, 1530 + 530);
    core_set_time(c, 2100);
    feed(c, "a");                                           // typing restarts the blink in the "on" phase
    cs = paint(c, 300, 100);
    eq(t, "caret on after typing", caret_count(&cs) as i64, 1);
    core_set_time(c, 2100 + 529);
    cs = paint(c, 300, 100);
    eq(t, "still on just before the period ends", caret_count(&cs) as i64, 1);
    core_set_time(c, 2100 + 530);
    cs = paint(c, 300, 100);
    eq(t, "off one period after typing", caret_count(&cs) as i64, 0);
    key(c, KEY_LEFT, 0);                                    // moving the caret restarts it too
    cs = paint(c, 300, 100);
    eq(t, "on after a caret move", caret_count(&cs) as i64, 1);
    core_free(c);
}

fun test_blink_can_be_switched_off(t: ptr<T>) {
    begin(t, "blink_can_be_switched_off");
    var c: ptr<Ctx> = new_ctx(t);
    var th: ptr<Theme> = core_theme(c);
    th.caret_blink_ms = 0;
    blink_fixture(c);
    core_input_focus(c, 7);
    core_set_time(c, 5000);
    var cs: Cmds = paint(c, 300, 100);
    eq(t, "always on", caret_count(&cs) as i64, 1);
    eq(t, "nothing to wake up for", core_wake_ms(c) as i64, NONE as i64);
    th.caret_blink_ms = 200;                                // a faster blink from the theme
    core_set_time(c, 5000);
    eq(t, "the period is the theme's", core_wake_ms(c) as i64, 200);
    core_free(c);
}

// ---- progress bar, radio button, tab ----------------------------------------------------------

fun test_progress_bar_layout_and_paint(t: ptr<T>) {
    begin(t, "progress_bar_layout_and_paint");
    var c: ptr<Ctx> = new_ctx(t);
    var col: i32 = core_column(c, NONE, 0, 0);
    var p: i32 = core_progress(c, col, 3, 4);
    core_layout(c, 300, 100);
    rect_is(t, "natural size: an input's width, the theme's thickness", c, p, 0, 0, 200, 10);
    var cs: Cmds = paint(c, 300, 100);
    var track: i64 = find_color(&cs, core_theme(c).scroll_track);
    var fill: i64 = find_color(&cs, core_theme(c).accent);
    ok(t, "a track", track >= 0);
    ok(t, "a fill", fill >= 0);
    if (fill >= 0) { eq(t, "three quarters of 200", cmd(&cs, fill).w as i64, 150); }
    // clamping and degenerate values
    core_clear(c);
    col = core_column(c, NONE, 0, 0);
    core_progress(c, col, 99, 4);
    core_layout(c, 300, 100);
    cs = paint(c, 300, 100);
    fill = find_color(&cs, core_theme(c).accent);
    if (fill >= 0) { eq(t, "over the maximum: full", cmd(&cs, fill).w as i64, 200); }
    core_clear(c);
    col = core_column(c, NONE, 0, 0);
    core_progress(c, col, 0, 4);
    core_progress(c, col, 5, 0);
    core_layout(c, 300, 100);
    cs = paint(c, 300, 100);
    eq(t, "zero or no maximum: no fill", count_color(&cs, core_theme(c).accent) as i64, 0);
    core_free(c);
}

fun test_progress_bar_is_not_interactive(t: ptr<T>) {
    begin(t, "progress_bar_is_not_interactive");
    var c: ptr<Ctx> = new_ctx(t);
    var col: i32 = core_column(c, NONE, 0, 0);
    core_progress(c, col, 1, 2);
    core_layout(c, 300, 100);
    eq(t, "no message", core_click(c, 10, 5, 0) as i64, NONE as i64);
    eq(t, "hit", core_hit(c, 10, 5) as i64, NONE as i64);
    eq(t, "not in the Tab order", core_focus_next(c, false) as i64, 0);
    core_free(c);
}

fun test_radio_button(t: ptr<T>) {
    begin(t, "radio_button");
    var c: ptr<Ctx> = new_ctx(t);
    var col: i32 = core_column(c, NONE, 10, 6);
    var a: i32 = core_radio(c, col, "One" as ptr<u8>, 3, true, 1);       // 16 + 8 + 24 = 48 wide
    var b: i32 = core_radio(c, col, "Two" as ptr<u8>, 3, false, 2);
    core_layout(c, 300, 100);
    rect_is(t, "a", c, a, 10, 10, 48, 16);
    rect_is(t, "b", c, b, 10, 32, 48, 16);
    var cs: Cmds = paint(c, 300, 100);
    eq(t, "no tick strokes: a radio has a dot", count_kind(&cs, CMD_LINE) as i64, 0);
    var circles: i32 = 0;
    var dots: i32 = 0;
    var i: i64 = 0;
    while (i < cs.n) {
        var d: ptr<DrawCmd> = cmd(&cs, i);
        if ((d.kind == CMD_ROUND_FILL || d.kind == CMD_ROUND_BORDER) && d.w == 16 && d.h == 16 && d.text_len == 8) { circles += 1; }
        if (d.kind == CMD_ROUND_FILL && d.color == core_theme(c).accent) { dots += 1; }
        i += 1;
    }
    eq(t, "two circles (fill + outline each)", circles as i64, 4);
    eq(t, "one dot, on the selected choice", dots as i64, 1);
    eq(t, "click the second", core_click(c, 12, 34, 0) as i64, 2);
    eq(t, "hit its label", core_hit(c, 50, 34) as i64, 2);
    core_free(c);
}

fun test_radio_buttons_take_the_keyboard(t: ptr<T>) {
    begin(t, "radio_buttons_take_the_keyboard");
    var c: ptr<Ctx> = new_ctx(t);
    var col: i32 = core_column(c, NONE, 0, 0);
    core_radio(c, col, "A" as ptr<u8>, 1, false, 11);
    core_radio(c, col, "B" as ptr<u8>, 1, false, 12);
    core_layout(c, 300, 100);
    key(c, KEY_TAB, 0);
    eq(t, "first radio focused", core_focused_msg(c) as i64, 11);
    key(c, KEY_TAB, 0);
    eq(t, "Tab to the second", core_focused_msg(c) as i64, 12);
    eq(t, "Space selects it", feed(c, " ") as i64, INPUT_ACTIVATED as i64);
    eq(t, "its message", core_activated(c) as i64, 12);
    core_free(c);
}

fun test_tabs(t: ptr<T>) {
    begin(t, "tabs");
    var c: ptr<Ctx> = new_ctx(t);
    var row: i32 = core_row(c, NONE, 0, 0);
    var a: i32 = core_tab(c, row, "One" as ptr<u8>, 3, true, 1);
    var b: i32 = core_tab(c, row, "Two" as ptr<u8>, 3, false, 2);
    core_layout(c, 300, 100);
    rect_is(t, "a tab is as big as a button: 24 + 24 wide", c, a, 0, 0, 48, 28);
    var cs: Cmds = paint(c, 300, 100);
    // the window background, the selected tab's fill and underline, and two labels: the idle tab draws nothing else
    eq(t, "the selected tab has the field colour", count_color(&cs, core_theme(c).field) as i64, 1);
    var underline: bool = false;
    var i: i64 = 0;
    while (i < cs.n) {
        var d: ptr<DrawCmd> = cmd(&cs, i);
        if (d.kind == CMD_FILL && d.h == 2 && d.w == 48 && d.y == 26 && d.color == core_theme(c).accent) { underline = true; }
        i += 1;
    }
    ok(t, "an accent underline under the selected one", underline);
    eq(t, "no outline on tabs", count_kind(&cs, CMD_ROUND_BORDER) as i64, 0);
    eq(t, "click the other tab", core_click(c, 60, 10, 0) as i64, 2);
    core_set_pointer(c, 60, 10, false);                     // hovering the idle tab fills it
    cs = paint(c, 300, 100);
    eq(t, "hover colour", count_color(&cs, core_theme(c).button_hover) as i64, 1);
    key(c, KEY_TAB, 0);
    eq(t, "tabs are focusable", core_focused_msg(c) as i64, 1);
    core_free(c);
}

// ---- slider -------------------------------------------------------------------------------------

fun slider_fixture(c: ptr<Ctx>, max: i32) -> i32 {
    core_clear(c);
    var col: i32 = core_column(c, NONE, 0, 0);
    var sl: i32 = core_slider(c, col, 4, 0, max);
    core_layout(c, 300, 100);
    return sl;
}

fun test_slider_value_and_range(t: ptr<T>) {
    begin(t, "slider_value_and_range");
    var c: ptr<Ctx> = new_ctx(t);
    var sl: i32 = slider_fixture(c, 100);
    rect_is(t, "an input's width, the handle's height", c, sl, 0, 0, 200, 16);
    eq(t, "starts at the minimum", core_slider_get(c, 4) as i64, 0);
    core_slider_set(c, 4, 50);
    slider_fixture(c, 100);
    eq(t, "set and kept across a rebuild", core_slider_get(c, 4) as i64, 50);
    core_slider_set(c, 4, 500);
    slider_fixture(c, 100);
    eq(t, "clamped to the maximum at layout", core_slider_get(c, 4) as i64, 100);
    core_slider_set(c, 4, -7);
    slider_fixture(c, 100);
    eq(t, "and to the minimum", core_slider_get(c, 4) as i64, 0);
    core_slider_set(c, 4, 80);
    slider_fixture(c, 50);
    eq(t, "a smaller range pulls the value in", core_slider_get(c, 4) as i64, 50);
    eq(t, "unknown id", core_slider_get(c, 99) as i64, 0);
    core_free(c);
}

fun test_slider_mouse(t: ptr<T>) {
    begin(t, "slider_mouse");
    var c: ptr<Ctx> = new_ctx(t);
    slider_fixture(c, 100);                                 // 184 px of travel between the handle centres 8 .. 192
    eq(t, "a click returns no message", core_click(c, 100, 8, 0) as i64, NONE as i64);
    eq(t, "the middle", core_slider_get(c, 4) as i64, 50);
    eq(t, "the slider has the focus", core_focused(c) as i64, 4);
    core_click(c, 0, 8, 0);
    eq(t, "the left end", core_slider_get(c, 4) as i64, 0);
    core_click(c, 199, 8, 0);
    eq(t, "the right end", core_slider_get(c, 4) as i64, 100);
    core_click(c, 20, 8, 0);
    eq(t, "drag to 150", core_drag(c, 150, 40) as i64, 1);   // only x matters, the pointer may leave the groove
    eq(t, "value", core_slider_get(c, 4) as i64, 77);
    eq(t, "the same place again: no change", core_drag(c, 150, 40) as i64, 0);
    eq(t, "beyond the end", core_drag(c, 900, 8) as i64, 1);
    eq(t, "clamped", core_slider_get(c, 4) as i64, 100);
    core_release(c);
    eq(t, "released: the drag is over", core_drag(c, 10, 8) as i64, 0);
    eq(t, "(the value stays)", core_slider_get(c, 4) as i64, 100);
    core_free(c);
}

fun test_slider_keyboard(t: ptr<T>) {
    begin(t, "slider_keyboard");
    var c: ptr<Ctx> = new_ctx(t);
    slider_fixture(c, 100);
    core_slider_set(c, 4, 50);
    slider_fixture(c, 100);
    key(c, KEY_TAB, 0);
    eq(t, "Tab focuses the slider", core_focused(c) as i64, 4);
    eq(t, "Left", key(c, KEY_LEFT, 0) as i64, INPUT_CHANGED as i64);
    eq(t, "one down", core_slider_get(c, 4) as i64, 49);
    key(c, KEY_RIGHT, 0);
    key(c, KEY_RIGHT, 0);
    eq(t, "two up", core_slider_get(c, 4) as i64, 51);
    key(c, KEY_PAGE_UP, 0);
    eq(t, "page up: a tenth of the range", core_slider_get(c, 4) as i64, 61);
    key(c, KEY_PAGE_DOWN, 0);
    eq(t, "page down", core_slider_get(c, 4) as i64, 51);
    eq(t, "Home", key(c, KEY_HOME, 0) as i64, INPUT_CHANGED as i64);
    eq(t, "the minimum", core_slider_get(c, 4) as i64, 0);
    eq(t, "Home again: nothing changes", key(c, KEY_HOME, 0) as i64, 0);
    eq(t, "Left at the minimum", key(c, KEY_LEFT, 0) as i64, 0);
    key(c, KEY_END, 0);
    eq(t, "End: the maximum", core_slider_get(c, 4) as i64, 100);
    eq(t, "Right at the maximum", key(c, KEY_RIGHT, 0) as i64, 0);
    eq(t, "Enter does nothing on a slider", key(c, KEY_ENTER, 0) as i64, 0);
    eq(t, "typed text does nothing", feed(c, "5") as i64, 0);
    core_free(c);
}

fun test_slider_paint(t: ptr<T>) {
    begin(t, "slider_paint");
    var c: ptr<Ctx> = new_ctx(t);
    slider_fixture(c, 100);
    core_slider_set(c, 4, 50);
    slider_fixture(c, 100);
    var cs: Cmds = paint(c, 300, 100);
    var groove: i64 = find_color(&cs, core_theme(c).scroll_track);
    ok(t, "a groove", groove >= 0);
    if (groove >= 0) {
        eq(t, "groove x: half a handle in", cmd(&cs, groove).x as i64, 8);
        eq(t, "groove width", cmd(&cs, groove).w as i64, 184);
        eq(t, "groove thickness", cmd(&cs, groove).h as i64, 4);
    }
    var filled: i64 = find_color(&cs, core_theme(c).accent);
    ok(t, "the part up to the handle is filled", filled >= 0);
    if (filled >= 0) { eq(t, "half of 184", cmd(&cs, filled).w as i64, 92); }
    var handle: i64 = find_color(&cs, core_theme(c).field);
    ok(t, "a handle", handle >= 0);
    if (handle >= 0) {
        eq(t, "handle x", cmd(&cs, handle).x as i64, 92);
        eq(t, "handle size", cmd(&cs, handle).w as i64, 16);
        eq(t, "a circle", cmd(&cs, handle).text_len as i64, 8);
    }
    eq(t, "no ring before the keyboard moved the focus", count_focus_border(&cs) as i64, 0);
    key(c, KEY_TAB, 0);
    cs = paint(c, 300, 100);
    eq(t, "a focused handle: its rim and the two line ring", count_focus_border(&cs) as i64, 3);
    core_free(c);
}

fun test_two_sliders_are_independent(t: ptr<T>) {
    begin(t, "two_sliders_are_independent");
    var c: ptr<Ctx> = new_ctx(t);
    var col: i32 = core_column(c, NONE, 0, 4);
    core_slider(c, col, 1, 0, 10);
    core_slider(c, col, 2, 100, 200);
    core_layout(c, 300, 100);
    eq(t, "the second starts at its own minimum", core_slider_get(c, 2) as i64, 100);
    core_click(c, 199, 8, 0);                               // the first one
    eq(t, "first", core_slider_get(c, 1) as i64, 10);
    eq(t, "second untouched", core_slider_get(c, 2) as i64, 100);
    core_release(c);
    core_click(c, 100, 28, 0);                              // the second one (y 20..36)
    eq(t, "second moved", core_slider_get(c, 2) as i64, 150);
    key(c, KEY_TAB, SHIFT);
    eq(t, "Shift+Tab goes back to the first", core_focused(c) as i64, 1);
    core_free(c);
}

// ---- overlays -------------------------------------------------------------------------------------

// A column with a "main" button (msg 1) at (10, 20), 32 x 28.
fun overlay_main(c: ptr<Ctx>) -> i32 {
    core_clear(c);
    var col: i32 = core_column(c, NONE, 0, 0);
    core_style(c, col, P_MARGIN, 0);
    var spacer: i32 = bx(c, col, 10, 20, 0);
    var row: i32 = core_row(c, col, 0, 0);
    bx(c, row, 10, 10, 0);
    return btn(c, row, "m", 1);
}

fun test_overlay_is_laid_out_on_its_own_and_hit_first(t: ptr<T>) {
    begin(t, "overlay_is_laid_out_on_its_own_and_hit_first");
    var c: ptr<Ctx> = new_ctx(t);
    var col: i32 = core_column(c, NONE, 0, 0);
    var main: i32 = btn(c, col, "m", 1);                    // 32 x 28 at (0, 0)
    var ov: i32 = core_overlay(c, NONE, OVERLAY_AT, 20, 10);
    var inner: i32 = btn(c, ov, "X", 9);                    // 32 x 28
    core_layout(c, 300, 100);
    rect_is(t, "the overlay box", c, ov, 20, 10, 32, 28);
    rect_is(t, "its button", c, inner, 20, 10, 32, 28);
    rect_is(t, "the main button is unaffected", c, main, 0, 0, 32, 28);
    eq(t, "over both: the overlay wins", core_hit(c, 25, 15) as i64, 9);
    eq(t, "the main button where nothing covers it", core_hit(c, 5, 5) as i64, 1);
    eq(t, "a click goes the same way", core_click(c, 25, 15, 0) as i64, 9);
    eq(t, "a second root is still refused", core_column(c, NONE, 0, 0) as i64, NONE as i64);
    core_free(c);
}

fun test_an_overlay_blocks_what_is_under_it(t: ptr<T>) {
    begin(t, "an_overlay_blocks_what_is_under_it");
    var c: ptr<Ctx> = new_ctx(t);
    var col: i32 = core_column(c, NONE, 0, 0);
    btn(c, col, "m", 1);                                    // 32 x 28 at (0, 0)
    var ov: i32 = core_overlay(c, NONE, OVERLAY_AT, 0, 0);
    core_style(c, ov, P_PADDING, 12);
    btn(c, ov, "X", 9);                                     // the overlay is 56 x 52: a 12 px frame around its button
    core_layout(c, 300, 100);
    eq(t, "the frame covers the main button", core_hit(c, 5, 5) as i64, NONE as i64);
    eq(t, "a click on the frame goes nowhere", core_click(c, 5, 5, 0) as i64, NONE as i64);
    eq(t, "the overlay's own button", core_hit(c, 20, 20) as i64, 9);
    eq(t, "outside the overlay the main button would answer", core_hit(c, 5, 60) as i64, NONE as i64);   // (nothing there)
    core_free(c);
}

fun test_overlay_placements(t: ptr<T>) {
    begin(t, "overlay_placements");
    var c: ptr<Ctx> = new_ctx(t);
    var a: i32 = overlay_main(c);                           // the anchor: 32 x 28 at (10, 20)
    var below: i32 = core_overlay(c, a, OVERLAY_BELOW, 0, 4);
    btn(c, below, "B", 2);
    var above: i32 = core_overlay(c, a, OVERLAY_ABOVE, 0, 0);
    btn(c, above, "A", 3);
    var right: i32 = core_overlay(c, a, OVERLAY_RIGHT, 6, 0);
    btn(c, right, "R", 4);
    var wide: i32 = core_overlay(c, a, OVERLAY_BELOW + OVERLAY_MATCH_WIDTH, 0, 60);
    var tiny: i32 = bx(c, wide, 10, 10, 0);
    core_layout(c, 300, 200);
    rect_is(t, "anchor", c, a, 10, 20, 32, 28);
    rect_is(t, "below: left edges aligned, a gap of 4", c, below, 10, 52, 32, 28);
    rect_is(t, "above: its bottom edge on the anchor's top", c, above, 10, -8 + 8, 32, 28);
    rect_is(t, "right: to the side, a gap of 6", c, right, 48, 20, 32, 28);
    eq(t, "match width: at least as wide as the anchor", rc(c, wide, 2) as i64, 32);
    ok(t, "(and the content stays small)", rc(c, tiny, 2) == 10);
    core_free(c);
}

fun test_overlays_stay_inside_the_window(t: ptr<T>) {
    begin(t, "overlays_stay_inside_the_window");
