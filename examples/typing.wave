// SPDX-License-Identifier: MPL-2.0
//
// Keyboard text input: type (Hangul too, through your input method),
// Backspace deletes a character, Enter clears the line, Esc quits.
// Run with:  WUI_RUN=typing wavec --std-root=$HOME/.wave/bin/std run build.wave

import("wui")::{Ui, Window, WinEvent, ui_new, ui_free, ui_clear, ui_column, ui_text, ui_layout,
                ui_background, ui_border, ui_align, ui_padding, ui_width, win_open, win_ok, win_close,
                win_next, win_text, win_draw, win_pending, win_width, win_height, UI_ROOT, UI_STRETCH,
                EV_CLOSE, EV_EXPOSE, EV_TEXT, EV_KEY, KEY_BACKSPACE, KEY_ENTER, KEY_ESCAPE};
import("std::mem::alloc")::{mem_alloc, mem_free};

const CAP: i64 = 512;

struct Line {
    buf: ptr<u8>;   // NUL-terminated UTF-8
    len: i64;
}

fun line_append(l: ptr<Line>, piece: ptr<u8>, n: i64) {
    if (l.len + n + 1 > CAP) { return; }
    var i: i64 = 0;
    while (i < n) { l.buf[l.len + i] = piece[i]; i += 1; }
    l.len += n;
    l.buf[l.len] = 0;
}

// Removes the last character: back up over UTF-8 continuation bytes (10xxxxxx).
fun line_backspace(l: ptr<Line>) {
    if (l.len == 0) { return; }
    l.len -= 1;
    while (l.len > 0 && (l.buf[l.len] & 0xC0) == 0x80) { l.len -= 1; }
    l.buf[l.len] = 0;
}

fun view(ui: ptr<Ui>, l: ptr<Line>, w: i32, h: i32) {
    ui_clear(ui);
    var col: i32 = ui_column(ui, UI_ROOT, 16, 10);
    ui_align(ui, col, UI_STRETCH);
    ui_text(ui, col, "wui typing - type here, Backspace deletes, Enter clears, Esc quits");
    var box: i32 = ui_column(ui, col, 8, 0);
    ui_background(ui, box, 0xFFFFFFFF);
    ui_border(ui, box, 0xFFB0B0B0);
    if (l.len == 0) {
        ui_text(ui, box, " ");                 // keep the box one line high
    } else {
        ui_text(ui, box, l.buf as str);
    }
    ui_layout(ui, w, h);
}

fun main() {
    var win: Window = win_open("wui typing", 520, 140);
    if (!win_ok(&win)) {
        println("cannot open a window (no X display or libX11)");
        return;
    }
    var ui: Ui = ui_new();
    var line: Line = Line { buf: mem_alloc(CAP), len: 0 };
    line.buf[0] = 0;
    var piece: ptr<u8> = mem_alloc(64);
    var ev: WinEvent = WinEvent { kind: 0, x: 0, y: 0, a: 0, width: 0, height: 0, mods: 0 };

    view(&ui, &line, win_width(&win), win_height(&win));
    win_draw(&win, &ui);

    var running: bool = true;
    while (running) {
        var kind: i32 = win_next(&win, &ev);
        if (kind == EV_CLOSE) {
            running = false;
        } else {
            if (kind == EV_TEXT) {
                var n: i64 = win_text(&win, piece, 64);
                line_append(&line, piece, n);
            }
            if (kind == EV_KEY) {
                if (ev.a == KEY_BACKSPACE) { line_backspace(&line); }
                if (ev.a == KEY_ENTER) { line.len = 0; line.buf[0] = 0; }
                if (ev.a == KEY_ESCAPE) { running = false; }
            }
            if (kind == EV_EXPOSE) {
                // only the picture needs showing again: no view(), and only for the last of a burst
                if (!win_pending(&win)) { win_draw(&win, &ui); }
            } else {
                view(&ui, &line, win_width(&win), win_height(&win));
                win_draw(&win, &ui);
            }
        }
    }

    mem_free(piece, 64);
    mem_free(line.buf, CAP);
    ui_free(&ui);
    win_close(&win);
}
