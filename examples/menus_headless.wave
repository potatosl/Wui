// SPDX-License-Identifier: MPL-2.0
//
// Renders the menu example without a window to build/menus_*.ppm: the bar alone, the File
// menu open, the Edit menu open (opened by moving along the bar) and a tooltip.
// Run with:  WUI_RUN=menus_headless wavec --std-root=$HOME/.wave/bin/std run build.wave

import("wui")::{Ui, ui_new, ui_free, ui_render, ui_click, ui_set_pointer, ui_set_time};
import("std::fs::file")::{write};
import("std::mem::alloc")::{mem_alloc, mem_free};
import("./menus_view")::{Model, menus_view};

const W: i32 = 420;
const H: i32 = 220;

fun save(ui: ptr<Ui>, name: str) {
    var pixels: ptr<u8> = mem_alloc((W * H * 4) as i64);
    ui_render(ui, pixels, W, H);
    var n: i32 = W * H;
    var rgb: ptr<u8> = mem_alloc((n * 3) as i64);
    var i: i32 = 0;
    while (i < n) {
        rgb[i * 3] = pixels[i * 4 + 2];
        rgb[i * 3 + 1] = pixels[i * 4 + 1];
        rgb[i * 3 + 2] = pixels[i * 4];
        i += 1;
    }
    var header: str = "P6\n420 220\n255\n";
    var hp: ptr<u8> = header as ptr<u8>;
    var hlen: i64 = 0;
    while (hp[hlen] != 0) { hlen += 1; }
    var total: i64 = hlen + (n as i64) * 3;
    var img: ptr<u8> = mem_alloc(total);
    var k: i64 = 0;
    while (k < hlen) { img[k] = hp[k]; k += 1; }
    var j: i64 = 0;
    while (j < (n as i64) * 3) { img[hlen + j] = rgb[j]; j += 1; }
    write(name, img, total);
    mem_free(img, total);
    mem_free(rgb, (n * 3) as i64);
    mem_free(pixels, (W * H * 4) as i64);
}

fun main() {
    var ui: Ui = ui_new();
    var m: Model = Model { last: 0 };
    ui_set_time(&ui, 0);
    menus_view(&ui, &m, W, H);
    save(&ui, "build/menus_closed.ppm");
    // the File menu open, the pointer on its second item
    ui_set_pointer(&ui, 14, 12, true);
    ui_click(&ui, 14, 12, 0);
    menus_view(&ui, &m, W, H);
    ui_set_pointer(&ui, 30, 52, false);
    menus_view(&ui, &m, W, H);
    save(&ui, "build/menus_file.ppm");
    // moving along the bar opens the Edit menu instead
    ui_set_pointer(&ui, 64, 12, false);
    menus_view(&ui, &m, W, H);
    menus_view(&ui, &m, W, H);
    save(&ui, "build/menus_edit.ppm");
    // close it, rest the pointer on Save: no tooltip yet, then the tooltip
    ui_click(&ui, 300, 200, 0);
    ui_set_time(&ui, 0);                                // (ui_click sets the real clock: the picture is timed by hand)
    ui_set_pointer(&ui, 40, 100, false);
    menus_view(&ui, &m, W, H);
    save(&ui, "build/menus_wait.ppm");
    ui_set_time(&ui, 700);
    menus_view(&ui, &m, W, H);
    save(&ui, "build/menus_tip.ppm");
    ui_free(&ui);
    println("wrote build/menus_closed.ppm, menus_file.ppm, menus_edit.ppm, menus_wait.ppm, menus_tip.ppm");
}
