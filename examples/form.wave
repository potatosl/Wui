// SPDX-License-Identifier: MPL-2.0
//
// A small form: two text inputs, a checkbox and buttons. Click an input (or
// press Tab) to focus it, type, press Enter or click Greet. Select text with
// the mouse (drag, Shift+click) or the keyboard (Shift+arrows, Ctrl+A) and use
// Ctrl+C / Ctrl+X / Ctrl+V. Esc quits.
// Run with:  WUI_RUN=form wavec --std-root=$HOME/.wave/bin/std run build.wave

import("wui")::{Ui, Window, WinEvent, ui_new, ui_free, ui_clear, ui_column, ui_row, ui_text, ui_button, ui_checkbox,
                ui_input, ui_input_get, ui_input_focus, ui_focused, ui_click, ui_drag, ui_release, ui_feed_text, win_feed_key,
                ui_layout, ui_set_pointer, ui_align, ui_grow, ui_width, ui_background, ui_border,
                win_open, win_ok, win_close, win_next_timeout, ui_wake_ms, win_text, win_draw, win_pending, win_width, win_height,
                ui_activated, UI_ROOT, UI_NO_MSG, UI_NO_INPUT, UI_STRETCH, UI_SUBMIT, UI_ACTIVATED,
                EV_CLOSE, EV_EXPOSE, EV_MOVE, EV_DOWN, EV_UP, EV_TEXT, EV_KEY, KEY_ESCAPE};
import("std::mem::alloc")::{mem_alloc, mem_free};

const ID_NAME: i32 = 1;
const ID_CITY: i32 = 2;
const MSG_GREET: i32 = 1;
const MSG_CLEAR: i32 = 2;
const MSG_SUBSCRIBE: i32 = 3;
const CAP: i64 = 600;

struct Model {
    greeting: ptr<u8>;   // NUL-terminated UTF-8, empty until Greet
    subscribed: bool;
}

fun copy_in(dst: ptr<u8>, at: i64, src: ptr<u8>) -> i64 {
    var i: i64 = 0;
    while (src[i] != 0 && at + i < CAP - 1) { dst[at + i] = src[i]; i += 1; }
    dst[at + i] = 0;
    return at + i;
}

// greeting = "Hello, <name> from <city>!"
fun greet(ui: ptr<Ui>, m: ptr<Model>) {
    var name: ptr<u8> = mem_alloc(CAP);
    var city: ptr<u8> = mem_alloc(CAP);
    name[0] = 0;
    city[0] = 0;
    ui_input_get(ui, ID_NAME, name, CAP);
    ui_input_get(ui, ID_CITY, city, CAP);
    var n: i64 = 0;
    var hello: str = "Hello, ";
    var from: str = " from ";
    var bang: str = "!";
    n = copy_in(m.greeting, n, hello as ptr<u8>);
    n = copy_in(m.greeting, n, name);
    n = copy_in(m.greeting, n, from as ptr<u8>);
    n = copy_in(m.greeting, n, city);
    n = copy_in(m.greeting, n, bang as ptr<u8>);
    mem_free(name, CAP);
    mem_free(city, CAP);
}

fun update(ui: ptr<Ui>, m: ptr<Model>, msg: i32) {
    if (msg == MSG_GREET) { greet(ui, m); }
    if (msg == MSG_CLEAR) { m.greeting[0] = 0; }
    if (msg == MSG_SUBSCRIBE) { m.subscribed = !m.subscribed; }
}

fun view(ui: ptr<Ui>, m: ptr<Model>, w: i32, h: i32) {
    ui_clear(ui);
    var page: i32 = ui_column(ui, UI_ROOT, 20, 10);
    ui_align(ui, page, UI_STRETCH);
    ui_text(ui, page, "wui form  (Tab: next field, Enter: greet, Esc: quit)");
    ui_input(ui, page, ID_NAME, "Name");
    ui_input(ui, page, ID_CITY, "City / 도시");
    ui_checkbox(ui, page, "Subscribe / 소식 받기", m.subscribed, MSG_SUBSCRIBE);
    var row: i32 = ui_row(ui, page, 0, 8);
    ui_button(ui, row, "Greet", MSG_GREET);
    ui_button(ui, row, "Clear", MSG_CLEAR);
    if (m.subscribed) {
        ui_text(ui, page, "You will get the news. / 소식을 받습니다.");
    }
    if (m.greeting[0] != 0) {
        ui_text(ui, page, m.greeting as str);
    }
    ui_layout(ui, w, h);
}

fun main() {
    var win: Window = win_open("wui form", 420, 300);
    if (!win_ok(&win)) {
        println("cannot open a window (no X display or libX11)");
        return;
    }
    var ui: Ui = ui_new();
    var model: Model = Model { greeting: mem_alloc(CAP), subscribed: false };
    model.greeting[0] = 0;
    var piece: ptr<u8> = mem_alloc(64);
    var ev: WinEvent = WinEvent { kind: 0, x: 0, y: 0, a: 0, width: 0, height: 0, mods: 0 };

    view(&ui, &model, win_width(&win), win_height(&win));    // inputs must exist before they can be focused
    ui_input_focus(&ui, ID_NAME);
    win_draw(&win, &ui);

    var running: bool = true;
    var down: bool = false;          // left button held (for dragging a selection)
    while (running) {
        // wakes up by itself when the caret of the focused input has to blink (EV_TIMEOUT: just redraw)
        var kind: i32 = win_next_timeout(&win, &ev, ui_wake_ms(&ui));
        if (kind == EV_CLOSE) {
            running = false;
        } else {
            if (kind == EV_DOWN && ev.a == 1) {
                down = true;
                var msg: i32 = ui_click(&ui, ev.x, ev.y, ev.mods);
                if (msg != UI_NO_MSG) { update(&ui, &model, msg); }
            }
            if (kind == EV_UP && ev.a == 1) {
                down = false;
                ui_release(&ui);
            }
            if (kind == EV_MOVE) {
                ui_set_pointer(&ui, ev.x, ev.y, false);
                if (down) { ui_drag(&ui, ev.x, ev.y); }
            }
            if (kind == EV_TEXT) {
                var n: i64 = win_text(&win, piece, 64);
                var r: i32 = ui_feed_text(&ui, piece, n);
                if ((r & UI_ACTIVATED) != 0) { update(&ui, &model, ui_activated(&ui)); }    // Space on a focused checkbox / button
            }
            if (kind == EV_KEY) {
                if (ev.a == KEY_ESCAPE) { running = false; }
                // Tab / Shift+Tab move the focus between the inputs, the checkbox and the buttons
                var r: i32 = win_feed_key(&win, &ui, ev.a, ev.mods);
                if ((r & UI_SUBMIT) != 0) { update(&ui, &model, MSG_GREET); }
                if ((r & UI_ACTIVATED) != 0) { update(&ui, &model, ui_activated(&ui)); }
            }
            if (kind == EV_EXPOSE) {
                // only the picture needs showing again: no view(), and only for the last of a burst
                if (!win_pending(&win)) { win_draw(&win, &ui); }
            } else {
                view(&ui, &model, win_width(&win), win_height(&win));
                win_draw(&win, &ui);
            }
        }
    }

    mem_free(piece, 64);
    mem_free(model.greeting, CAP);
    ui_free(&ui);
    win_close(&win);
}
