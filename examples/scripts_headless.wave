// SPDX-License-Identifier: MPL-2.0
//
// Draws one line per writing system to build/scripts.ppm, to see which scripts
// the installed system fonts cover. Run with:  WUI_RUN=scripts_headless wavec --std-root=$HOME/.wave/bin/std run build.wave

import("wui")::{Ui, ui_new, ui_free, ui_clear, ui_column, ui_row, ui_text, ui_button, ui_checkbox, ui_input,
                ui_input_set, ui_input_focus, ui_layout, ui_render, ui_align, ui_feed_key,
                UI_ROOT, UI_STRETCH, KEY_LEFT};
import("std::fs::file")::{write};
import("std::mem::alloc")::{mem_alloc, mem_free};

const W: i32 = 420;
const H: i32 = 330;

fun main() {
    var ui: Ui = ui_new();
    var pixels: ptr<u8> = mem_alloc((W * H * 4) as i64);
    var rgb: ptr<u8> = mem_alloc((W * H * 3) as i64);

    ui_clear(&ui);
    var page: i32 = ui_column(&ui, UI_ROOT, 16, 6);
    ui_text(&ui, page, "English: The quick brown fox");
    ui_text(&ui, page, "Latin accents: Café Ñandú Straße Ångström Łódź");
    ui_text(&ui, page, "Greek: Γειά σου Κόσμε αβγδ");
    ui_text(&ui, page, "Cyrillic: Привет, мир! Ёжик");
    ui_text(&ui, page, "Korean: 안녕하세요 한글 입력");
    ui_text(&ui, page, "Japanese: こんにちは カタカナ 日本語");
    ui_text(&ui, page, "Chinese: 你好，世界 简体 繁體");
    ui_text(&ui, page, "Arabic: مرحبا بالعالم");
    ui_text(&ui, page, "Hebrew: שלום עולם");
    ui_text(&ui, page, "Thai: สวัสดีชาวโลก");
    ui_text(&ui, page, "Hindi: नमस्ते दुनिया");
    ui_text(&ui, page, "Symbols: ← → ✓ ★ © € ₩ ½ ≤");
    ui_text(&ui, page, "Emoji: 😀 🎉 👍");
    ui_layout(&ui, W, H);
    ui_render(&ui, pixels, W, H);

    var n: i32 = W * H;
    var i: i32 = 0;
    while (i < n) {
        rgb[i * 3] = pixels[i * 4 + 2];
        rgb[i * 3 + 1] = pixels[i * 4 + 1];
        rgb[i * 3 + 2] = pixels[i * 4];
        i += 1;
    }
    var header: str = "P6\n420 330\n255\n";
    var hp: ptr<u8> = header as ptr<u8>;
    var hlen: i64 = 0;
    while (hp[hlen] != 0) { hlen += 1; }
    var total: i64 = hlen + (n as i64) * 3;
    var img: ptr<u8> = mem_alloc(total);
    var k: i64 = 0;
    while (k < hlen) { img[k] = hp[k]; k += 1; }
    var j: i64 = 0;
    while (j < (n as i64) * 3) { img[hlen + j] = rgb[j]; j += 1; }
    write("build/scripts.ppm", img, total);
    mem_free(img, total);
    mem_free(pixels, (W * H * 4) as i64);
    mem_free(rgb, (W * H * 3) as i64);
    ui_free(&ui);
    println("wrote build/scripts.ppm");
}
