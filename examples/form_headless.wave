//
// Renders the form without a window to build/form.ppm: one input filled and
// focused (with a caret), one empty showing its placeholder.
// Run with:  WUI_RUN=form_headless wavec --std-root=$HOME/.wave/bin/std run build.wave

import("wui")::{Ui, ui_new, ui_free, ui_clear, ui_column, ui_row, ui_text, ui_button, ui_checkbox, ui_input,
                ui_input_set, ui_input_focus, ui_layout, ui_render, ui_align, ui_feed_key, ui_drag, ui_click, ui_background, ui_border, ui_radius, ui_margin, ui_color, ui_padding, ui_grow, ui_width,
                UI_ROOT, UI_STRETCH, KEY_LEFT, KEY_END};
import("std::fs::file")::{write};
import("std::mem::alloc")::{mem_alloc, mem_free};

const W: i32 = 420;
const H: i32 = 330;

fun main() {
    var ui: Ui = ui_new();
    var pixels: ptr<u8> = mem_alloc((W * H * 4) as i64);
    var rgb: ptr<u8> = mem_alloc((W * H * 3) as i64);

    ui_clear(&ui);
    var page: i32 = ui_column(&ui, UI_ROOT, 12, 0);
    ui_align(&ui, page, UI_STRETCH);
    // a rounded white card with margins around its children and its own text colour
    var card: i32 = ui_column(&ui, page, 14, 8);
    ui_align(&ui, card, UI_STRETCH);
    ui_background(&ui, card, 0xFFFFFFFF);
    ui_border(&ui, card, 0xFFC8C8C8);
    ui_radius(&ui, card, 10);
    ui_color(&ui, card, 0xFF1E3A8A);                       // dark blue text, inherited
    ui_text(&ui, card, "wui form  (Tab: next field, Enter: greet)");
    ui_input(&ui, card, 1, "Name");
    ui_input(&ui, card, 2, "City / 도시");
    ui_checkbox(&ui, card, "Subscribe / 소식 받기", true, 3);
    ui_checkbox(&ui, card, "Dark mode", false, 4);
    var row: i32 = ui_row(&ui, card, 0, 8);
    ui_align(&ui, row, UI_STRETCH);
    var greet: i32 = ui_button(&ui, row, "Greet", 1);
    ui_grow(&ui, greet, 1);
    ui_button(&ui, row, "Clear", 2);
    // a pill-shaped status badge in a different colour, with a margin
    var badge: i32 = ui_column(&ui, page, 6, 0);
    ui_background(&ui, badge, 0xFFDCFCE7);
    ui_radius(&ui, badge, 14);
    ui_margin(&ui, badge, 10);
    ui_color(&ui, badge, 0xFF166534);
    ui_text(&ui, badge, "Saved / 저장됨");
    ui_input_set(&ui, 1, "한글 이름 Hanna");
    ui_input_focus(&ui, 1);
    ui_layout(&ui, W, H);
    // select "이름 Han" with Shift+arrows: caret to the end, then 6 characters left
    ui_feed_key(&ui, KEY_END, 0);
    ui_feed_key(&ui, KEY_LEFT, 0);
    ui_feed_key(&ui, KEY_LEFT, 0);
    ui_feed_key(&ui, KEY_LEFT, 1);
    ui_feed_key(&ui, KEY_LEFT, 1);
    ui_feed_key(&ui, KEY_LEFT, 1);
    ui_feed_key(&ui, KEY_LEFT, 1);
    ui_feed_key(&ui, KEY_LEFT, 1);
    ui_feed_key(&ui, KEY_LEFT, 1);
    ui_layout(&ui, W, H);
    ui_render(&ui, pixels, W, H);

    var n: i32 = W * H;
    var i: i32 = 0;
    while (i < n) {
        rgb[i * 3] = pixels[i * 4 + 2];
        rgb[i * 3 + 1] = pixels[i * 4 + 1];
        rgb[i * 3 + 2] = pixels[i * 4];
        i += 1;
    }
    var header: str = "P6\n420 330\n255\n";
    var hp: ptr<u8> = header as ptr<u8>;
    var hlen: i64 = 0;
    while (hp[hlen] != 0) { hlen += 1; }
    var total: i64 = hlen + (n as i64) * 3;
    var img: ptr<u8> = mem_alloc(total);
    var k: i64 = 0;
    while (k < hlen) { img[k] = hp[k]; k += 1; }
    var j: i64 = 0;
    while (j < (n as i64) * 3) { img[hlen + j] = rgb[j]; j += 1; }
    write("build/form.ppm", img, total);
    mem_free(img, total);
    mem_free(pixels, (W * H * 4) as i64);
    mem_free(rgb, (W * H * 3) as i64);
    ui_free(&ui);
    println("wrote build/form.ppm");
}
