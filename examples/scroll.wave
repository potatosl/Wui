// SPDX-License-Identifier: MPL-2.0
//
// A scroll box: 40 rows (a button, a label and a checkbox mixed in) in a
// scrolling list under a header. Turn the mouse wheel over the list; the
// Top / Bottom buttons jump to the ends, and the scrollbar thumb can be
// dragged with the mouse. PageUp / PageDown / Up / Down / Home / End scroll
// too. Esc quits.
// Run with:  WUI_RUN=scroll wavec --std-root=$HOME/.wave/bin/std run build.wave

import("wui")::{Ui, Window, WinEvent, ui_new, ui_free, ui_clear, ui_column, ui_row, ui_text, ui_button, ui_checkbox,
                ui_scroll_box, ui_scroll, ui_scroll_set, ui_click, ui_drag, ui_release, ui_layout, ui_set_pointer, ui_align, ui_grow,
                ui_background, ui_border, ui_padding, ui_gap, ui_radius,
                win_open, win_ok, win_close, win_next, win_draw, win_feed_key, win_pending, win_width, win_height,
                UI_ROOT, UI_NO_MSG, UI_STRETCH,
                EV_CLOSE, EV_EXPOSE, EV_MOVE, EV_DOWN, EV_UP, EV_WHEEL, EV_KEY, KEY_ESCAPE};
import("std::mem::alloc")::{mem_alloc, mem_free};

const ID_LIST: i32 = 1;
const MSG_TOP: i32 = 1;
const MSG_BOTTOM: i32 = 2;
const MSG_ROW: i32 = 100;       // + row number
const ROWS: i32 = 40;

struct Model {
    picked: i32;                // last clicked row, -1 = none
    label: ptr<u8>;
}

// "Row NN" into buf
fun row_label(buf: ptr<u8>, n: i32) {
    var w: str = "Row ";
    var p: ptr<u8> = w as ptr<u8>;
    var i: i32 = 0;
    while (p[i] != 0) { buf[i] = p[i]; i += 1; }
    buf[i] = (48 + n / 10) as u8;
    buf[i + 1] = (48 + n % 10) as u8;
    buf[i + 2] = 0;
}

fun update(ui: ptr<Ui>, m: ptr<Model>, msg: i32) {
    if (msg == MSG_TOP) { ui_scroll_set(ui, ID_LIST, 0); }
    if (msg == MSG_BOTTOM) { ui_scroll_set(ui, ID_LIST, 1000000); }
    if (msg >= MSG_ROW) { m.picked = msg - MSG_ROW; }
}

fun view(ui: ptr<Ui>, m: ptr<Model>, w: i32, h: i32) {
    ui_clear(ui);
    var page: i32 = ui_column(ui, UI_ROOT, 12, 8);
    ui_align(ui, page, UI_STRETCH);
    var bar: i32 = ui_row(ui, page, 0, 8);
    ui_button(ui, bar, "Top", MSG_TOP);
    ui_button(ui, bar, "Bottom", MSG_BOTTOM);
    if (m.picked >= 0) {
        row_label(m.label, m.picked);
        ui_text(ui, bar, m.label as str);
    } else {
        ui_text(ui, bar, "wheel over the list");
    }
    var list: i32 = ui_scroll_box(ui, page, ID_LIST);
    ui_grow(ui, list, 1);
    ui_align(ui, list, UI_STRETCH);
    ui_gap(ui, list, 6);
    ui_padding(ui, list, 8);
    ui_background(ui, list, 0xFFFFFFFF);
    ui_border(ui, list, 0xFFC8C8C8);
    var buf: ptr<u8> = mem_alloc(16);
    var i: i32 = 0;
    while (i < ROWS) {
        row_label(buf, i);
        var r: i32 = ui_row(ui, list, 0, 8);
        ui_button(ui, r, "pick", MSG_ROW + i);
        ui_text(ui, r, buf as str);
        i += 1;
    }
    mem_free(buf, 16);
    ui_layout(ui, w, h);
}

fun main() {
    var win: Window = win_open("wui scroll", 360, 420);
    if (!win_ok(&win)) {
        println("cannot open a window (no X display or libX11)");
        return;
    }
    var ui: Ui = ui_new();
    var model: Model = Model { picked: -1, label: mem_alloc(16) };
    var ev: WinEvent = WinEvent { kind: 0, x: 0, y: 0, a: 0, width: 0, height: 0, mods: 0 };
    view(&ui, &model, win_width(&win), win_height(&win));
    win_draw(&win, &ui);

    var running: bool = true;
    var down: bool = false;          // left button held (dragging the scrollbar thumb)
    while (running) {
        var kind: i32 = win_next(&win, &ev);
        if (kind == EV_CLOSE) {
            running = false;
        } else {
            if (kind == EV_DOWN && ev.a == 1) {
                down = true;
                var msg: i32 = ui_click(&ui, ev.x, ev.y, ev.mods);
                if (msg != UI_NO_MSG) { update(&ui, &model, msg); }
            }
            if (kind == EV_UP && ev.a == 1) {
                down = false;
                ui_release(&ui);
            }
            if (kind == EV_MOVE) {
                ui_set_pointer(&ui, ev.x, ev.y, false);
                if (down) { ui_drag(&ui, ev.x, ev.y); }
            }
            if (kind == EV_WHEEL) { ui_scroll(&ui, ev.x, ev.y, ev.a); }
            if (kind == EV_KEY) {
                if (ev.a == KEY_ESCAPE) { running = false; }
                win_feed_key(&win, &ui, ev.a, ev.mods);
            }
            if (kind == EV_EXPOSE) {
                // only the picture needs showing again: no view(), and only for the last of a burst
                if (!win_pending(&win)) { win_draw(&win, &ui); }
            } else {
                view(&ui, &model, win_width(&win), win_height(&win));
                win_draw(&win, &ui);
            }
        }
    }
    mem_free(model.label, 16);
    ui_free(&ui);
    win_close(&win);
}
