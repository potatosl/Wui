// SPDX-License-Identifier: MPL-2.0
//
// The Elm loop without a window: Model -> view -> (click) -> update -> view.
// Clicks are simulated with ui_hit(), and every state is rendered to a PPM
// image so the result can be looked at. Run with:  WUI_RUN=counter_headless wavec --std-root=$HOME/.wave/bin/std run build.wave

import("wui")::{Ui, UiRect, ui_new, ui_free, ui_clear, ui_column, ui_row, ui_text, ui_button,
                ui_layout, ui_rect, ui_grow, ui_justify, ui_align, ui_background, ui_border, ui_padding, UI_CENTER, UI_STRETCH, ui_set_pointer, ui_hit, ui_render, ui_version, UI_ROOT, UI_NO_MSG};
import("std::fs::file")::{write};
import("std::mem::alloc")::{mem_alloc, mem_free};

const MSG_DEC: i32 = 0;
const MSG_INC: i32 = 1;
const MSG_RESET: i32 = 2;

const WIDTH: i32 = 260;
const HEIGHT: i32 = 120;

struct Model {
    count: i32;
}

fun update(m: ptr<Model>, msg: i32) {
    if (msg == MSG_INC) { m.count += 1; }
    if (msg == MSG_DEC) { m.count -= 1; }
    if (msg == MSG_RESET) { m.count = 0; }
}

// Writes "Count: <n>" into buf (NUL-terminated).
fun label(buf: ptr<u8>, n: i32) {
    var prefix: str = "Count: ";
    var p: ptr<u8> = prefix as ptr<u8>;
    var len: i32 = 0;
    while (p[len] != 0) { buf[len] = p[len]; len += 1; }
    var v: i32 = n;
    if (v < 0) { buf[len] = 45; len += 1; v = 0 - v; }
    var digits: array<u8, 12>;
    var nd: i32 = 0;
    if (v == 0) { digits[0] = 48; nd = 1; }
    while (v > 0) { digits[nd] = (48 + v % 10) as u8; nd += 1; v = v / 10; }
    while (nd > 0) { nd -= 1; buf[len] = digits[nd]; len += 1; }
    buf[len] = 0;
}

fun view(ui: ptr<Ui>, m: ptr<Model>, text_buf: ptr<u8>) {
    ui_clear(ui);
    label(text_buf, m.count);
    var col: i32 = ui_column(ui, UI_ROOT, 16, 10);
    ui_align(ui, col, UI_STRETCH);                       // children as wide as the window
    ui_text(ui, col, "wui counter / 카운터 한글");
    ui_text(ui, col, text_buf as str);
    var row: i32 = ui_row(ui, col, 0, 8);
    ui_align(ui, row, UI_STRETCH);
    ui_grow(ui, ui_button(ui, row, "-", MSG_DEC), 1);    // three equal buttons
    ui_grow(ui, ui_button(ui, row, "+", MSG_INC), 1);
    ui_grow(ui, ui_button(ui, row, "Reset", MSG_RESET), 1);
    ui_layout(ui, WIDTH, HEIGHT);
}

// Renders the current tree into a PPM file.
fun snapshot(ui: ptr<Ui>, pixels: ptr<u8>, rgb: ptr<u8>, path: str) {
    ui_render(ui, pixels, WIDTH, HEIGHT);
    var n: i32 = WIDTH * HEIGHT;
    var i: i32 = 0;
    while (i < n) {
        rgb[i * 3] = pixels[i * 4 + 2];
        rgb[i * 3 + 1] = pixels[i * 4 + 1];
        rgb[i * 3 + 2] = pixels[i * 4];
        i += 1;
    }
    var header: str = "P6\n260 120\n255\n";
    var hp: ptr<u8> = header as ptr<u8>;
    var hlen: i64 = 0;
    while (hp[hlen] != 0) { hlen += 1; }
    var img: ptr<u8> = mem_alloc(hlen + (n as i64) * 3);
    var k: i64 = 0;
    while (k < hlen) { img[k] = hp[k]; k += 1; }
    var j: i64 = 0;
    while (j < (n as i64) * 3) { img[hlen + j] = rgb[j]; j += 1; }
    write(path, img, hlen + (n as i64) * 3);
    mem_free(img, hlen + (n as i64) * 3);
}

// Clicks the centre of the node `id` and applies the resulting message.
fun click(ui: ptr<Ui>, m: ptr<Model>, id: i32) {
    var r: UiRect = ui_rect(ui, id);
    var msg: i32 = ui_hit(ui, r.x + r.w / 2, r.y + r.h / 2);
    if (msg != UI_NO_MSG) { update(m, msg); }
}

fun main() {
    println("wui {}", ui_version());
    var ui: Ui = ui_new();
    var model: Model = Model { count: 0 };
    var text_buf: ptr<u8> = mem_alloc(64);
    var pixels: ptr<u8> = mem_alloc((WIDTH * HEIGHT * 4) as i64);
    var rgb: ptr<u8> = mem_alloc((WIDTH * HEIGHT * 3) as i64);

    view(&ui, &model, text_buf);
    snapshot(&ui, pixels, rgb, "build/counter_0.ppm");

    // node ids: 0 column, 1 title, 2 count text, 3 row, 4 "-", 5 "+", 6 "Reset"
    click(&ui, &model, 5);
    click(&ui, &model, 5);
    click(&ui, &model, 5);
    view(&ui, &model, text_buf);
    println("after 3 x '+': count = {}", model.count);
    ui_set_pointer(&ui, 120, 85, false);
    snapshot(&ui, pixels, rgb, "build/counter_3.ppm");

    click(&ui, &model, 4);
    view(&ui, &model, text_buf);
    println("after '-': count = {}", model.count);

    click(&ui, &model, 6);
    view(&ui, &model, text_buf);
    println("after 'Reset': count = {}", model.count);

    mem_free(text_buf, 64);
    mem_free(pixels, (WIDTH * HEIGHT * 4) as i64);
    mem_free(rgb, (WIDTH * HEIGHT * 3) as i64);
    ui_free(&ui);
}
