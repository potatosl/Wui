// SPDX-License-Identifier: MPL-2.0
//
// A file dialog: "Open file..." lists the current directory in a modal dialog. Click a folder to go
// in, "Up" to go out, click a file to select it and Open to choose it. The wheel scrolls the list;
// Tab walks the entries; Esc closes the dialog, then quits.
// Run with:  WUI_RUN=files wavec --std-root=$HOME/.wave/bin/std run build.wave

import("wui")::{Ui, Window, WinEvent, ui_new, ui_free, ui_click, ui_drag, ui_release, ui_set_pointer, ui_scroll, ui_feed_text,
                ui_activated, ui_wake_ms, dirlist_new, dirlist_free, path_cwd,
                win_open, win_ok, win_close, win_next_timeout, win_text, win_draw, win_pending, win_width, win_height, win_feed_key,
                UI_NO_MSG, UI_ACTIVATED,
                EV_CLOSE, EV_EXPOSE, EV_MOVE, EV_DOWN, EV_UP, EV_WHEEL, EV_TEXT, EV_KEY, KEY_ESCAPE};
import("std::mem::alloc")::{mem_alloc, mem_free};
import("./files_view")::{Model, files_view, files_update, files_reload, MSG_CANCEL, PATH_CAP};

fun main() {
    var win: Window = win_open("wui files", 460, 420);
    if (!win_ok(&win)) {
        println("cannot open a window (no X display or libX11)");
        return;
    }
    var ui: Ui = ui_new();
    var model: Model = Model { open: false, path: mem_alloc(PATH_CAP), list: dirlist_new(), selected: -1, chosen: mem_alloc(PATH_CAP) };
    model.chosen[0] = 0;
    if (!path_cwd(model.path, PATH_CAP)) { model.path[0] = 46; model.path[1] = 0; }
    var piece: ptr<u8> = mem_alloc(64);
    var ev: WinEvent = WinEvent { kind: 0, x: 0, y: 0, a: 0, width: 0, height: 0, mods: 0 };
    files_view(&ui, &model, win_width(&win), win_height(&win));
    win_draw(&win, &ui);

    var running: bool = true;
    var down: bool = false;
    while (running) {
        var kind: i32 = win_next_timeout(&win, &ev, ui_wake_ms(&ui));
        if (kind == EV_CLOSE) {
            running = false;
        } else {
            if (kind == EV_DOWN && ev.a == 1) {
                down = true;
                ui_set_pointer(&ui, ev.x, ev.y, true);
                var msg: i32 = ui_click(&ui, ev.x, ev.y, ev.mods);
                if (msg != UI_NO_MSG) { files_update(&model, msg); }
            }
            if (kind == EV_UP && ev.a == 1) { down = false; ui_set_pointer(&ui, ev.x, ev.y, false); ui_release(&ui); }
            if (kind == EV_MOVE) {
                ui_set_pointer(&ui, ev.x, ev.y, down);
                if (down) { ui_drag(&ui, ev.x, ev.y); }
            }
            if (kind == EV_WHEEL) { ui_scroll(&ui, ev.x, ev.y, ev.a); }
            if (kind == EV_TEXT) {
                var n: i64 = win_text(&win, piece, 64);
                var r: i32 = ui_feed_text(&ui, piece, n);
                if ((r & UI_ACTIVATED) != 0) { files_update(&model, ui_activated(&ui)); }
            }
            if (kind == EV_KEY) {
                if (ev.a == KEY_ESCAPE) {
                    if (model.open) { files_update(&model, MSG_CANCEL); } else { running = false; }
                } else {
                    var r: i32 = win_feed_key(&win, &ui, ev.a, ev.mods);
                    if ((r & UI_ACTIVATED) != 0) { files_update(&model, ui_activated(&ui)); }
                }
            }
            if (kind == EV_EXPOSE) {
                if (!win_pending(&win)) { win_draw(&win, &ui); }
            } else {
                files_view(&ui, &model, win_width(&win), win_height(&win));
                win_draw(&win, &ui);
            }
        }
    }
    mem_free(piece, 64);
    mem_free(model.path, PATH_CAP);
    mem_free(model.chosen, PATH_CAP);
    dirlist_free(&model.list);
    ui_free(&ui);
    win_close(&win);
}
