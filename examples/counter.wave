// SPDX-License-Identifier: MPL-2.0
//
// A real window: click the buttons, or press Tab to move between them and Enter / Space
// to press the focused one (a ring shows which). Esc quits.
// Run with:  WUI_RUN=counter wavec --std-root=$HOME/.wave/bin/std run build.wave

import("wui")::{Ui, Window, WinEvent, ui_new, ui_free, ui_clear, ui_column, ui_row, ui_text,
                ui_button, ui_layout, ui_set_pointer, ui_grow, ui_align, ui_justify, ui_background, ui_border, ui_width,
                UI_CENTER, UI_STRETCH, win_width, win_height, ui_hit, win_open, win_ok, win_close,
                win_next, win_draw, win_pending, win_text, win_feed_key, ui_feed_text, ui_activated, UI_ROOT, UI_NO_MSG,
                UI_ACTIVATED, EV_CLOSE, EV_EXPOSE, EV_MOVE, EV_DOWN, EV_UP, EV_TEXT, EV_KEY, KEY_ESCAPE};
import("std::mem::alloc")::{mem_alloc, mem_free};

const MSG_DEC: i32 = 0;
const MSG_INC: i32 = 1;
const MSG_RESET: i32 = 2;

struct Model {
    count: i32;
}

fun update(m: ptr<Model>, msg: i32) {
    if (msg == MSG_INC) { m.count += 1; }
    if (msg == MSG_DEC) { m.count -= 1; }
    if (msg == MSG_RESET) { m.count = 0; }
}

// Writes "Count: <n>" into buf (NUL-terminated).
fun label(buf: ptr<u8>, n: i32) {
    var prefix: str = "Count: ";
    var p: ptr<u8> = prefix as ptr<u8>;
    var len: i32 = 0;
    while (p[len] != 0) { buf[len] = p[len]; len += 1; }
    var v: i32 = n;
    if (v < 0) { buf[len] = 45; len += 1; v = 0 - v; }
    var digits: array<u8, 12>;
    var nd: i32 = 0;
    if (v == 0) { digits[0] = 48; nd = 1; }
    while (v > 0) { digits[nd] = (48 + v % 10) as u8; nd += 1; v = v / 10; }
    while (nd > 0) { nd -= 1; buf[len] = digits[nd]; len += 1; }
    buf[len] = 0;
}

fun view(ui: ptr<Ui>, m: ptr<Model>, text_buf: ptr<u8>, w: i32, h: i32) {
    ui_clear(ui);
    label(text_buf, m.count);
    // The card sits in the middle of the window and follows its size.
    var page: i32 = ui_column(ui, UI_ROOT, 16, 0);
    ui_justify(ui, page, UI_CENTER);
    ui_align(ui, page, UI_CENTER);
    var card: i32 = ui_column(ui, page, 16, 10);
    ui_width(ui, card, 260);
    ui_align(ui, card, UI_STRETCH);
    ui_background(ui, card, 0xFFFFFFFF);
    ui_border(ui, card, 0xFFB0B0B0);
    ui_text(ui, card, "wui counter / 카운터");
    ui_text(ui, card, text_buf as str);
    var row: i32 = ui_row(ui, card, 0, 8);
    ui_align(ui, row, UI_STRETCH);
    ui_grow(ui, ui_button(ui, row, "-", MSG_DEC), 1);
    ui_grow(ui, ui_button(ui, row, "+", MSG_INC), 1);
    ui_grow(ui, ui_button(ui, row, "Reset", MSG_RESET), 1);
    ui_layout(ui, w, h);
}

fun main() {
    var win: Window = win_open("wui counter", 320, 160);
    if (!win_ok(&win)) {
        println("cannot open a window (no X display or libX11)");
        return;
    }
    var ui: Ui = ui_new();
    var model: Model = Model { count: 0 };
    var text_buf: ptr<u8> = mem_alloc(64);
    var piece: ptr<u8> = mem_alloc(64);
    var ev: WinEvent = WinEvent { kind: 0, x: 0, y: 0, a: 0, width: 0, height: 0, mods: 0 };

    view(&ui, &model, text_buf, win_width(&win), win_height(&win));
    win_draw(&win, &ui);

    var running: bool = true;
    while (running) {
        var kind: i32 = win_next(&win, &ev);
        if (kind == EV_CLOSE) {
            running = false;
        } else {
            if (kind == EV_MOVE) {
                ui_set_pointer(&ui, ev.x, ev.y, false);
            }
            if (kind == EV_DOWN && ev.a == 1) {
                ui_set_pointer(&ui, ev.x, ev.y, true);
            }
            if (kind == EV_UP && ev.a == 1) {
                ui_set_pointer(&ui, ev.x, ev.y, false);
                var msg: i32 = ui_hit(&ui, ev.x, ev.y);
                if (msg != UI_NO_MSG) { update(&model, msg); }
            }
            // keyboard: Tab / Shift+Tab move the focus, Enter and Space press the focused button
            if (kind == EV_KEY) {
                if (ev.a == KEY_ESCAPE) { running = false; }
                var r: i32 = win_feed_key(&win, &ui, ev.a, ev.mods);
                if ((r & UI_ACTIVATED) != 0) { update(&model, ui_activated(&ui)); }
            }
            if (kind == EV_TEXT) {
                var n: i64 = win_text(&win, piece, 64);
                var r: i32 = ui_feed_text(&ui, piece, n);
                if ((r & UI_ACTIVATED) != 0) { update(&model, ui_activated(&ui)); }
            }
            if (kind == EV_EXPOSE) {
                // only the picture needs showing again: no view(), and only for the last of a burst
                if (!win_pending(&win)) { win_draw(&win, &ui); }
            } else {
                view(&ui, &model, text_buf, win_width(&win), win_height(&win));
                win_draw(&win, &ui);
            }
        }
    }

    mem_free(piece, 64);
    mem_free(text_buf, 64);
    ui_free(&ui);
    win_close(&win);
}
